{
  "prefix": "mbedtls_psa_async_crypto",
  "type": "transparent",
  "mbedtls/h_condition": "defined(MBEDTLS_PSA_ASYNC_CRYPTO_DRIVER_ENABLED) || defined(MBEDTLS_PSA_ASYNC_CRYPTO_SIGNATURE_DRIVER_ENABLED)",
  "headers": ["mbedtls/psa_crypto_async_driver.h"],
  "capabilities": [
    {
      "_comment": "Algorithm-agnostic interruptible dispatch into async PSA provider",
      "mbedtls/c_condition": "defined(MBEDTLS_PSA_ASYNC_CRYPTO_DRIVER_ENABLED)",
      "entry_points": [
        "operation_start",
        "operation_complete",
        "operation_abort",
        "operation_get_num_ops"
      ],
      "fallback": false
    },
    {
