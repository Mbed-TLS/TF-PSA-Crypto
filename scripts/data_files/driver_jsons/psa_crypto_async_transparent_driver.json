      "fallback": false
    },
    {
      "_comment": "TF-PSA interruptible random dispatch into async PSA provider",
      "mbedtls/c_condition": "defined(MBEDTLS_PSA_ASYNC_CRYPTO_DRIVER_ENABLED)",
      "entry_points": [
