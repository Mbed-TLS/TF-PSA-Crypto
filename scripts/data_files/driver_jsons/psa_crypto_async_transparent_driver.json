        "verify_hash_get_num_ops"
      ],
      "names": {
        "sign_hash_abort": "mbedtls_psa_async_crypto_transparent_signature_abort",
        "sign_hash_get_num_ops": "mbedtls_psa_async_crypto_transparent_signature_get_num_ops",
        "verify_hash_abort": "mbedtls_psa_async_crypto_transparent_signature_abort",
        "verify_hash_get_num_ops": "mbedtls_psa_async_crypto_transparent_signature_get_num_ops"
      },
      "fallback": false
