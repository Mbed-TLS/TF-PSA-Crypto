      "mbedtls/c_condition": "defined(MBEDTLS_PSA_ASYNC_CRYPTO_DRIVER_ENABLED)",
      "entry_points": [
        "export_public_key_iop_setup",
        "export_public_key_iop_complete",
        "export_public_key_iop_abort",
        "export_public_key_iop_get_num_ops"
