{
    async_provider_test_reset_request(request);
    request->operation = MBEDTLS_PSA_ASYNC_CRYPTO_OPERATION_KEY_AGREEMENT;
    request->key_type = PSA_KEY_TYPE_ECC_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1);
    request->key_bits = curve->order.length * 8;
    request->alg = PSA_ALG_ECDH;
    request->key.data = private_key;
    request->key.length = curve->order.length;
    request->private_key.data = private_key;
    request->private_key.length = curve->order.length;
    request->peer_key.data = peer_key;
    request->peer_key.length = 1 + 2 * curve->prime.length;
    request->shared_secret.data = shared_secret;
    request->shared_secret.length = curve->order.length;
    request->prime_curve = curve;
}

static void async_provider_test_make_export_public_key_request(
