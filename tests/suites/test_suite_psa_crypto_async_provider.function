static void async_provider_test_make_sign_hash_request(
    mbedtls_psa_async_crypto_request_t *request,
    const mbedtls_psa_async_crypto_prime_curve_t *curve,
    const uint8_t *private_key,
    const uint8_t *nonce,
    const uint8_t *hash,
    uint8_t *signature)
{
    async_provider_test_reset_request(request);
    request->operation = MBEDTLS_PSA_ASYNC_CRYPTO_OPERATION_SIGN_HASH;
    request->key_type = PSA_KEY_TYPE_ECC_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1);
    request->key_bits = curve->order.length * 8;
    request->alg = PSA_ALG_ECDSA(PSA_ALG_SHA_256);
    request->key.data = private_key;
    request->key.length = curve->order.length;
    request->private_key.data = private_key;
    request->private_key.length = curve->order.length;
    request->nonce_scalar.data = nonce;
    request->nonce_scalar.length = curve->order.length;
    request->hash.data = hash;
    request->hash.length = curve->hash_length;
    request->signature.data = signature;
    request->signature.length = 2 * curve->order.length;
    request->prime_curve = curve;
}

static void async_provider_test_make_verify_hash_request(
    mbedtls_psa_async_crypto_request_t *request,
    const mbedtls_psa_async_crypto_prime_curve_t *curve,
    const uint8_t *public_key,
    const uint8_t *hash,
    uint8_t *signature)
{
    async_provider_test_reset_request(request);
    request->operation = MBEDTLS_PSA_ASYNC_CRYPTO_OPERATION_VERIFY_HASH;
    request->key_type = PSA_KEY_TYPE_ECC_PUBLIC_KEY(PSA_ECC_FAMILY_SECP_R1);
    request->key_bits = curve->order.length * 8;
    request->alg = PSA_ALG_ECDSA(PSA_ALG_SHA_256);
    request->key.data = public_key;
    request->key.length = 1 + 2 * curve->prime.length;
    request->public_key.data = public_key;
    request->public_key.length = 1 + 2 * curve->prime.length;
    request->hash.data = hash;
    request->hash.length = curve->hash_length;
    request->signature.data = signature;
    request->signature.length = 2 * curve->order.length;
    request->prime_curve = curve;
}

static void async_provider_test_make_key_agreement_request(
    mbedtls_psa_async_crypto_request_t *request,
    const mbedtls_psa_async_crypto_prime_curve_t *curve,
