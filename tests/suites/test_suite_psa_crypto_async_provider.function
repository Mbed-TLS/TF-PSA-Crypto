#include <mbedtls/psa_crypto_async_curves.h>
#include <mbedtls/psa_crypto_async_driver.h>
#include <mbedtls/psa_crypto_async_provider.h>
#include <psa/crypto.h>
#include <string.h>

typedef struct {
    mbedtls_psa_async_crypto_capability_t capabilities;
    psa_status_t start_status;
    int complete_during_start;
    psa_status_t callback_status;
    int calls;
    mbedtls_psa_async_crypto_operation_kind_t last_operation;
    mbedtls_psa_async_crypto_hardware_completion_t completion;
    psa_algorithm_t algorithms[16];
} async_provider_test_context_t;

static mbedtls_psa_async_crypto_capability_t
async_provider_test_get_capabilities(void *context)
{
    async_provider_test_context_t *test_context = context;
    return test_context->capabilities;
}

static psa_status_t async_provider_test_operation(
    void *context,
    const mbedtls_psa_async_crypto_request_t *request,
    mbedtls_psa_async_crypto_hardware_completion_t *completion)
{
    async_provider_test_context_t *test_context = context;
    test_context->calls++;
    test_context->last_operation = request->operation;
    if (test_context->calls <= 16) {
        test_context->algorithms[test_context->calls - 1] = request->alg;
    }
    test_context->completion = *completion;

    if (request->output.data != NULL) {
        memset(request->output.data, 0x5a, request->output.length);
    }
    if (request->output_tag.data != NULL) {
        memset(request->output_tag.data, 0x5a, request->output_tag.length);
    }
    if (request->signature.data != NULL) {
        memset(request->signature.data, 0x5a, request->signature.length);
    }
    if (request->shared_secret.data != NULL) {
        memset(request->shared_secret.data, 0x5a,
               request->shared_secret.length);
    }
    if (request->public_key_output.data != NULL) {
        memset(request->public_key_output.data, 0x5a,
               request->public_key_output.length);
        request->public_key_output.data[0] = 0x04;
    }

    if (test_context->complete_during_start) {
        completion->callback(test_context->callback_status, completion->context);
    }

    return test_context->start_status;
}

static const mbedtls_psa_async_crypto_hardware_functions_t
    async_provider_test_functions = {
    async_provider_test_get_capabilities,
    async_provider_test_operation,
    async_provider_test_operation,
    async_provider_test_operation,
    async_provider_test_operation,
    async_provider_test_operation,
    async_provider_test_operation,
    async_provider_test_operation,
    async_provider_test_operation,
    async_provider_test_operation,
    async_provider_test_operation,
    async_provider_test_operation,
    async_provider_test_operation,
};

static void async_provider_test_reset_request(
    mbedtls_psa_async_crypto_request_t *request)
{
    memset(request, 0, sizeof(*request));
}

static void async_provider_test_make_random_request(
    mbedtls_psa_async_crypto_request_t *request,
    uint8_t *output,
    size_t output_length)
{
    async_provider_test_reset_request(request);
    request->operation = MBEDTLS_PSA_ASYNC_CRYPTO_OPERATION_RANDOM;
    request->output.data = output;
    request->output.length = output_length;
}

static void async_provider_test_make_cipher_request(
    mbedtls_psa_async_crypto_request_t *request,
    psa_algorithm_t alg,
    const uint8_t *key,
    size_t key_length,
    const uint8_t *iv,
    size_t iv_length,
    const uint8_t *input,
    uint8_t *output,
    size_t length)
{
    async_provider_test_reset_request(request);
    request->operation = MBEDTLS_PSA_ASYNC_CRYPTO_OPERATION_CIPHER;
    request->key_type = PSA_KEY_TYPE_AES;
    request->key_bits = key_length * 8;
    request->alg = alg;
    request->key.data = key;
    request->key.length = key_length;
    request->iv.data = iv;
    request->iv.length = iv_length;
    request->input.data = input;
    request->input.length = length;
    request->output.data = output;
    request->output.length = length;
}

static void async_provider_test_make_aead_request(
    mbedtls_psa_async_crypto_request_t *request,
    psa_algorithm_t alg,
    mbedtls_psa_async_crypto_direction_t direction,
    const uint8_t *key,
    size_t key_length,
    const uint8_t *nonce,
    size_t nonce_length,
    const uint8_t *input,
    uint8_t *output,
    size_t length,
    const uint8_t *input_tag,
    uint8_t *output_tag)
{
    async_provider_test_reset_request(request);
    request->operation = MBEDTLS_PSA_ASYNC_CRYPTO_OPERATION_AEAD;
    request->key_type = PSA_KEY_TYPE_AES;
    request->key_bits = key_length * 8;
    request->alg = alg;
    request->direction = direction;
    request->key.data = key;
    request->key.length = key_length;
    request->nonce.data = nonce;
    request->nonce.length = nonce_length;
    request->input.data = input;
    request->input.length = length;
    request->output.data = output;
    request->output.length = length;
    request->input_tag.data = input_tag;
    request->input_tag.length = input_tag == NULL ? 0 : 16;
    request->output_tag.data = output_tag;
    request->output_tag.length = output_tag == NULL ? 0 : 16;
}

static void async_provider_test_make_aes_ghash_request(
    mbedtls_psa_async_crypto_request_t *request,
