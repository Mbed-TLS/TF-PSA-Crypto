/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_import_export(int alg_arg, int bits_arg, int is_public,
                           data_t *key_data)
{
    psa_algorithm_t alg = alg_arg;
    size_t bits = (size_t) bits_arg;
    psa_key_type_t type = is_public ?
                          PSA_KEY_TYPE_SPAKE2P_PUBLIC_KEY(PSA_ECC_FAMILY_SECP_R1) :
                          PSA_KEY_TYPE_SPAKE2P_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1);
    psa_key_attributes_t attr = PSA_KEY_ATTRIBUTES_INIT;
    psa_key_attributes_t got = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t key = MBEDTLS_SVC_KEY_ID_INIT;
    uint8_t out[PSA_EXPORT_KEY_OUTPUT_SIZE(
                    PSA_KEY_TYPE_SPAKE2P_PUBLIC_KEY(PSA_ECC_FAMILY_SECP_R1), 521)];
    size_t olen = 0;

    PSA_INIT();

    psa_set_key_usage_flags(&attr, PSA_KEY_USAGE_EXPORT);
    psa_set_key_algorithm(&attr, alg);
    psa_set_key_type(&attr, type);
    PSA_ASSERT(psa_import_key(&attr, key_data->x, key_data->len, &key));

    /* The reported key size is the curve size, not the serialized length. */
    PSA_ASSERT(psa_get_key_attributes(key, &got));
    TEST_EQUAL(psa_get_key_bits(&got), bits);

    /* The export-size macro must be large enough, and export must round-trip. */
    TEST_ASSERT(PSA_EXPORT_KEY_OUTPUT_SIZE(type, bits) >= key_data->len);
    TEST_ASSERT(sizeof(out) >= key_data->len);
    PSA_ASSERT(psa_export_key(key, out, sizeof(out), &olen));
    TEST_MEMORY_COMPARE(out, olen, key_data->x, key_data->len);

exit:
    psa_reset_key_attributes(&got);
    psa_destroy_key(key);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_export_public_key(int alg_arg, int bits_arg,
                               data_t *key_pair_data,
                               data_t *expected_public_key)
{
    psa_algorithm_t alg = alg_arg;
    size_t bits = (size_t) bits_arg;
    psa_key_type_t type = PSA_KEY_TYPE_SPAKE2P_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1);
    psa_key_attributes_t attr = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t key = MBEDTLS_SVC_KEY_ID_INIT;
    uint8_t out[PSA_EXPORT_PUBLIC_KEY_OUTPUT_SIZE(
                    PSA_KEY_TYPE_SPAKE2P_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1), 521)];
    size_t olen = 0;

    PSA_INIT();

    psa_set_key_usage_flags(&attr, PSA_KEY_USAGE_EXPORT);
    psa_set_key_algorithm(&attr, alg);
    psa_set_key_type(&attr, type);
    PSA_ASSERT(psa_import_key(&attr, key_pair_data->x, key_pair_data->len,
                              &key));

    /* Exporting the public part of a key pair w0 || w1 computes the verifier
     * registration record w0 || L with L = w1 * P (RFC 9383). */
    TEST_ASSERT(PSA_EXPORT_PUBLIC_KEY_OUTPUT_SIZE(type, bits) >=
                expected_public_key->len);
    TEST_ASSERT(sizeof(out) >= expected_public_key->len);
    PSA_ASSERT(psa_export_public_key(key, out, sizeof(out), &olen));
    TEST_MEMORY_COMPARE(out, olen,
                        expected_public_key->x, expected_public_key->len);

    /* A too-small output buffer must be reported as such. */
    TEST_EQUAL(psa_export_public_key(key, out, expected_public_key->len - 1,
                                     &olen),
               PSA_ERROR_BUFFER_TOO_SMALL);

exit:
    psa_destroy_key(key);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE */
void pake_set_context(int alg_arg, data_t *context_arg,
                      int out_of_order, int repeated_call, int null_with_len,
                      int expected_status)
{
    /* This test initializes the operation structure by hand because
     * psa_pake_setup() does not support SPAKE2+ yet. Rewrite it to drive
     * the public API once SPAKE2+ setup is implemented. */
    psa_pake_operation_t client = psa_pake_operation_init();
    psa_algorithm_t alg = alg_arg;
    const uint8_t *context = context_arg->x;
    size_t context_len = context_arg->len;
    client.alg = alg;
    client.data.inputs.context = NULL;
    client.data.inputs.context_len = 0;
    client.data.inputs.password = NULL;
    client.data.inputs.password_len = 0;
    client.data.inputs.user = NULL;
    client.data.inputs.peer = NULL;
    client.data.inputs.user_len = 0;
    client.data.inputs.peer_len = 0;
    client.data.inputs.attributes = psa_key_attributes_init();
    client.data.inputs.cipher_suite = psa_pake_cipher_suite_init();

    PSA_INIT();

    if (null_with_len == 1) {
        /* A NULL context pointer is only valid with a zero length. */
        client.stage = PSA_PAKE_OPERATION_STAGE_COLLECT_INPUTS;
        TEST_EQUAL(psa_pake_set_context(&client, NULL, context_len),
                   expected_status);
    } else if (out_of_order == 1) {
        TEST_EQUAL(psa_pake_set_context(&client, context, context_len),
                   expected_status);
    } else if (repeated_call == 1) {
        client.stage = PSA_PAKE_OPERATION_STAGE_COLLECT_INPUTS;
        TEST_EQUAL(psa_pake_set_context(&client, context, context_len),
                   PSA_SUCCESS);
        /* The first call must have stored the context verbatim. */
        TEST_MEMORY_COMPARE(client.data.inputs.context,
                            client.data.inputs.context_len,
                            context, context_len);
        TEST_EQUAL(psa_pake_set_context(&client, context, context_len),
                   expected_status);
    } else {
        client.stage = PSA_PAKE_OPERATION_STAGE_COLLECT_INPUTS;
        TEST_EQUAL(psa_pake_set_context(&client, context, context_len),
                   expected_status);
        /* On success the context must be stored verbatim. */
        if (expected_status == PSA_SUCCESS) {
            TEST_MEMORY_COMPARE(client.data.inputs.context,
                                client.data.inputs.context_len,
                                context, context_len);
        }
    }

exit:
    psa_pake_abort(&client);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_setup_role_mismatch(int alg_arg, int bits_arg,
                                 data_t *public_key)
{
    /* A public key (w0||L, Verifier material) is verification-only: it must
     * not be accepted for the client (Prover) role. The server role accepts
     * either a public key or a key pair. */
    psa_algorithm_t alg = alg_arg;
    psa_pake_cipher_suite_t cs = psa_pake_cipher_suite_init();
    psa_pake_operation_t op = psa_pake_operation_init_short();
    psa_key_attributes_t attr = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t key = MBEDTLS_SVC_KEY_ID_INIT;

    PSA_INIT();

    psa_pake_cs_set_algorithm(&cs, alg);
    psa_pake_cs_set_primitive(&cs, PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                      PSA_ECC_FAMILY_SECP_R1,
                                                      (uint32_t) bits_arg));
    psa_set_key_usage_flags(&attr, PSA_KEY_USAGE_DERIVE);
    psa_set_key_algorithm(&attr, alg);
    psa_set_key_type(&attr, PSA_KEY_TYPE_SPAKE2P_PUBLIC_KEY(PSA_ECC_FAMILY_SECP_R1));
    PSA_ASSERT(psa_import_key(&attr, public_key->x, public_key->len, &key));

    PSA_ASSERT(psa_pake_setup(&op, key, &cs));
    /* The server role would be accepted, the client role must be rejected. */
    TEST_EQUAL(psa_pake_set_role(&op, PSA_PAKE_ROLE_CLIENT),
               PSA_ERROR_INVALID_ARGUMENT);

exit:
    psa_destroy_key(key);
    psa_pake_abort(&op);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SPAKE2P_HMAC:PSA_WANT_ALG_SPAKE2P_MATTER:PSA_WANT_ALG_SHA_256:PSA_WANT_ALG_HMAC:PSA_WANT_ECC_SECP_R1_256 */
void spake2p_prover_setup_bad_policy(data_t *client_key)
{
    /* psa_pake_setup() must enforce the password key's policy: the key needs
     * PSA_KEY_USAGE_DERIVE, and its permitted algorithm must cover the cipher
     * suite algorithm. */
    psa_algorithm_t hmac = PSA_ALG_SPAKE2P_HMAC(PSA_ALG_SHA_256);
    psa_pake_cipher_suite_t cs = psa_pake_cipher_suite_init();
    psa_pake_operation_t op = psa_pake_operation_init_short();
    psa_key_attributes_t attr = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t key = MBEDTLS_SVC_KEY_ID_INIT;

    PSA_INIT();

    psa_pake_cs_set_primitive(&cs, PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                      PSA_ECC_FAMILY_SECP_R1, 256));
    psa_set_key_type(&attr, PSA_KEY_TYPE_SPAKE2P_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1));
    psa_set_key_algorithm(&attr, hmac);

    /* Case 1: the key lacks PSA_KEY_USAGE_DERIVE. */
    psa_set_key_usage_flags(&attr, PSA_KEY_USAGE_EXPORT);
    PSA_ASSERT(psa_import_key(&attr, client_key->x, client_key->len, &key));
    psa_pake_cs_set_algorithm(&cs, hmac);
    TEST_EQUAL(psa_pake_setup(&op, key, &cs), PSA_ERROR_NOT_PERMITTED);
    psa_pake_abort(&op);
    psa_destroy_key(key);

    /* Case 2: the key policy permits HMAC, but the cipher suite asks for
     * the Matter (distinct) algorithm. */
    psa_set_key_usage_flags(&attr, PSA_KEY_USAGE_DERIVE);
    PSA_ASSERT(psa_import_key(&attr, client_key->x, client_key->len, &key));
    psa_pake_cs_set_algorithm(&cs, PSA_ALG_SPAKE2P_MATTER);
    TEST_EQUAL(psa_pake_setup(&op, key, &cs), PSA_ERROR_NOT_PERMITTED);

exit:
    psa_destroy_key(key);
    psa_pake_abort(&op);
    PSA_DONE();
}
/* END_CASE */


/* BEGIN_CASE depends_on:PSA_WANT_ALG_SPAKE2P_HMAC:PSA_WANT_ALG_SHA_256:PSA_WANT_ECC_SECP_R1_256 */
void spake2p_no_role(data_t *client_key)
{
    /* psa_pake_set_role() is mandatory for SPAKE2+: an operation without a
     * role must fail with PSA_ERROR_BAD_STATE at the first output. */
    psa_algorithm_t alg = PSA_ALG_SPAKE2P_HMAC(PSA_ALG_SHA_256);
    psa_pake_cipher_suite_t cs = psa_pake_cipher_suite_init();
    psa_pake_operation_t op = psa_pake_operation_init_short();
    psa_key_attributes_t attr = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t key = MBEDTLS_SVC_KEY_ID_INIT;
    uint8_t share[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t len = 0;

    PSA_INIT();

    psa_pake_cs_set_algorithm(&cs, alg);
    psa_pake_cs_set_primitive(&cs, PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                      PSA_ECC_FAMILY_SECP_R1, 256));
    psa_set_key_usage_flags(&attr, PSA_KEY_USAGE_DERIVE);
    psa_set_key_algorithm(&attr, alg);
    psa_set_key_type(&attr, PSA_KEY_TYPE_SPAKE2P_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1));
    PSA_ASSERT(psa_import_key(&attr, client_key->x, client_key->len, &key));

    PSA_ASSERT(psa_pake_setup(&op, key, &cs));
    /* No psa_pake_set_role() call. */
    TEST_EQUAL(psa_pake_output(&op, PSA_PAKE_STEP_KEY_SHARE,
                               share, sizeof(share), &len),
               PSA_ERROR_BAD_STATE);

exit:
    psa_destroy_key(key);
    psa_pake_abort(&op);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_prover_key_share_format(int alg_arg, int bits_arg,
                                     int expected_len, data_t *client_key)
{
    /* psa_pake_output(KEY_SHARE) for the Prover must emit an uncompressed SEC1
     * point of the curve's fixed length, consistent with PSA_PAKE_OUTPUT_SIZE(). */
    psa_algorithm_t alg = alg_arg;
    psa_pake_primitive_t prim = PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                   PSA_ECC_FAMILY_SECP_R1,
                                                   (uint32_t) bits_arg);
    psa_pake_operation_t client = psa_pake_operation_init_short();
    uint8_t shareP[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t lp = 0;

    PSA_INIT();

    TEST_EQUAL(PSA_PAKE_OUTPUT_SIZE(alg, prim, PSA_PAKE_STEP_KEY_SHARE),
               (size_t) expected_len);

    TEST_ASSERT(spake2p_setup_client(&client, alg, (uint32_t) bits_arg,
                                     client_key) == 1);

    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, sizeof(shareP), &lp));
    TEST_EQUAL(lp, (size_t) expected_len);
    TEST_EQUAL(shareP[0], 0x04);

exit:
    psa_pake_abort(&client);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_prover_key_share_buffer_too_small(int alg_arg, int bits_arg,
                                               data_t *client_key)
{
    /* An output buffer shorter than the key share must be rejected with
     * PSA_ERROR_BUFFER_TOO_SMALL, never silently truncated. */
    psa_algorithm_t alg = alg_arg;
    psa_pake_primitive_t prim = PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                   PSA_ECC_FAMILY_SECP_R1,
                                                   (uint32_t) bits_arg);
    psa_pake_operation_t client = psa_pake_operation_init_short();
    size_t share_len = PSA_PAKE_OUTPUT_SIZE(alg, prim, PSA_PAKE_STEP_KEY_SHARE);
    uint8_t shareP[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t lp = 0;

    PSA_INIT();

    TEST_ASSERT(share_len > 1);
    TEST_ASSERT(spake2p_setup_client(&client, alg, (uint32_t) bits_arg,
                                     client_key) == 1);

    TEST_EQUAL(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, share_len - 1, &lp),
               PSA_ERROR_BUFFER_TOO_SMALL);

exit:
    psa_pake_abort(&client);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SPAKE2P_MATTER:PSA_WANT_ALG_SHA_256:PSA_WANT_ECC_SECP_R1_256:MBEDTLS_TEST_HOOKS */
void spake2p_prover_key_share_psa_kat(data_t *context,
                                      data_t *client_key,
                                      data_t *x, data_t *exp_shareP)
{
    /* PSA_ALG_SPAKE2P_MATTER is the HMAC-SHA-256 profile pinned to P-256, which
     * is exactly the RFC 9383 P-256 HMAC ciphersuite. This validates the
     * alg-ID -> ciphersuite mapping and the PSA plumbing by reproducing the
     * published RFC vector byte-for-byte through psa_pake_output(), with the
     * published ephemeral pinned via the MBEDTLS_TEST_HOOKS injection seam. */
    psa_pake_cipher_suite_t cs = psa_pake_cipher_suite_init();
    psa_pake_operation_t client = psa_pake_operation_init_short();
    psa_key_attributes_t ca = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t ckey = MBEDTLS_SVC_KEY_ID_INIT;
    uint8_t shareP[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t lp = 0;

    PSA_INIT();

    psa_pake_cs_set_algorithm(&cs, PSA_ALG_SPAKE2P_MATTER);
    psa_pake_cs_set_primitive(&cs, PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                      PSA_ECC_FAMILY_SECP_R1, 256));

    psa_set_key_usage_flags(&ca, PSA_KEY_USAGE_DERIVE);
    psa_set_key_algorithm(&ca, PSA_ALG_SPAKE2P_MATTER);
    psa_set_key_type(&ca, PSA_KEY_TYPE_SPAKE2P_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1));
    PSA_ASSERT(psa_import_key(&ca, client_key->x, client_key->len, &ckey));

    PSA_ASSERT(psa_pake_setup(&client, ckey, &cs));
    PSA_ASSERT(psa_pake_set_role(&client, PSA_PAKE_ROLE_CLIENT));
    PSA_ASSERT(psa_pake_set_user(&client, spake2p_prover_client_id,
                                 sizeof(spake2p_prover_client_id)));
    PSA_ASSERT(psa_pake_set_peer(&client, spake2p_prover_server_id,
                                 sizeof(spake2p_prover_server_id)));
    PSA_ASSERT(psa_pake_set_context(&client, context->x, context->len));

    /* Client KEY_SHARE = shareP, with the published ephemeral x. */
    mbedtls_spake2p_test_injected_ephemeral = x->x;
    mbedtls_spake2p_test_injected_ephemeral_len = x->len;
    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, sizeof(shareP), &lp));
    TEST_MEMORY_COMPARE(shareP, lp, exp_shareP->x, exp_shareP->len);

exit:
    mbedtls_spake2p_test_injected_ephemeral = NULL;
    mbedtls_spake2p_test_injected_ephemeral_len = 0;
    psa_destroy_key(ckey);
    psa_pake_abort(&client);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_prover_no_identities(int alg_arg, int bits_arg,
                                  int expected_len, data_t *client_key)
{
    /* The SPAKE2+ identities are optional (PSA PAKE spec): if one is not
     * provided, a zero-length string is used for it in the protocol
     * (RFC 9383 Section 3.3). Producing a key share without calling
     * psa_pake_set_user()/psa_pake_set_peer() must succeed. */
    psa_algorithm_t alg = alg_arg;
    psa_pake_cipher_suite_t cs = psa_pake_cipher_suite_init();
    psa_pake_operation_t client = psa_pake_operation_init_short();
    psa_key_attributes_t ca = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t ckey = MBEDTLS_SVC_KEY_ID_INIT;
    uint8_t shareP[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t lp = 0;

    PSA_INIT();

    psa_pake_cs_set_algorithm(&cs, alg);
    psa_pake_cs_set_primitive(&cs, PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                      PSA_ECC_FAMILY_SECP_R1,
                                                      (uint32_t) bits_arg));
    psa_set_key_usage_flags(&ca, PSA_KEY_USAGE_DERIVE);
    psa_set_key_algorithm(&ca, alg);
    psa_set_key_type(&ca, PSA_KEY_TYPE_SPAKE2P_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1));
    PSA_ASSERT(psa_import_key(&ca, client_key->x, client_key->len, &ckey));

    PSA_ASSERT(psa_pake_setup(&client, ckey, &cs));
    PSA_ASSERT(psa_pake_set_role(&client, PSA_PAKE_ROLE_CLIENT));
    /* No psa_pake_set_user()/psa_pake_set_peer() calls. */
    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, sizeof(shareP), &lp));
    TEST_EQUAL(lp, (size_t) expected_len);
    TEST_EQUAL(shareP[0], 0x04);

exit:
    psa_destroy_key(ckey);
    psa_pake_abort(&client);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_JPAKE:PSA_WANT_ALG_SHA_256 */
void ecjpake_missing_identities()
{
    /* J-PAKE (unlike SPAKE2+) requires both identities to be provided
     * before the first input or output. */
    psa_algorithm_t alg = PSA_ALG_JPAKE(PSA_ALG_SHA_256);
    psa_pake_cipher_suite_t cs = psa_pake_cipher_suite_init();
    psa_pake_operation_t op = psa_pake_operation_init_short();
    psa_key_attributes_t attr = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t key = MBEDTLS_SVC_KEY_ID_INIT;
    const uint8_t password[] = "abcd";
    uint8_t output[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t output_len = 0;

    PSA_INIT();

    psa_pake_cs_set_algorithm(&cs, alg);
    psa_pake_cs_set_primitive(&cs, PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                      PSA_ECC_FAMILY_SECP_R1, 256));
    psa_set_key_usage_flags(&attr, PSA_KEY_USAGE_DERIVE);
    psa_set_key_algorithm(&attr, alg);
    psa_set_key_type(&attr, PSA_KEY_TYPE_PASSWORD);
    PSA_ASSERT(psa_import_key(&attr, password, sizeof(password), &key));

    PSA_ASSERT(psa_pake_setup(&op, key, &cs));
    TEST_EQUAL(psa_pake_output(&op, PSA_PAKE_STEP_KEY_SHARE,
                               output, sizeof(output), &output_len),
               PSA_ERROR_BAD_STATE);

exit:
    psa_destroy_key(key);
    psa_pake_abort(&op);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SPAKE2P_HMAC:PSA_WANT_ALG_SHA_256:PSA_WANT_ECC_SECP_R1_256:MBEDTLS_TEST_HOOKS */
void spake2p_verifier_key_share_psa_kat(int is_public, data_t *context,
                                        data_t *server_key,
                                        data_t *y, data_t *exp_shareV)
{
    /* Reproduce the RFC 9383 Appendix C P256-SHA256 Verifier key share
     * byte-for-byte through psa_pake_output(), with the published ephemeral
     * pinned via the MBEDTLS_TEST_HOOKS injection seam. Run once with the
     * registration record (public key, w0||L) and once with the key pair
     * (w0||w1): the Verifier may hold either, and with a key pair the
     * implementation derives L = w1*G itself. Both must run the server side
     * of the protocol and produce the same key share. */
    psa_algorithm_t alg = PSA_ALG_SPAKE2P_HMAC(PSA_ALG_SHA_256);
    psa_pake_cipher_suite_t cs = psa_pake_cipher_suite_init();
    psa_pake_operation_t server = psa_pake_operation_init_short();
    psa_key_attributes_t sa = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t skey = MBEDTLS_SVC_KEY_ID_INIT;
    uint8_t shareV[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t lv = 0;

    PSA_INIT();

    psa_pake_cs_set_algorithm(&cs, alg);
    psa_pake_cs_set_primitive(&cs, PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                      PSA_ECC_FAMILY_SECP_R1, 256));

    psa_set_key_usage_flags(&sa, PSA_KEY_USAGE_DERIVE);
    psa_set_key_algorithm(&sa, alg);
    psa_set_key_type(&sa, is_public ?
                     PSA_KEY_TYPE_SPAKE2P_PUBLIC_KEY(PSA_ECC_FAMILY_SECP_R1) :
                     PSA_KEY_TYPE_SPAKE2P_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1));
    PSA_ASSERT(psa_import_key(&sa, server_key->x, server_key->len, &skey));

    PSA_ASSERT(psa_pake_setup(&server, skey, &cs));
    PSA_ASSERT(psa_pake_set_role(&server, PSA_PAKE_ROLE_SERVER));
    /* The Verifier's own identity is the server one. */
    PSA_ASSERT(psa_pake_set_user(&server, spake2p_prover_server_id,
                                 sizeof(spake2p_prover_server_id)));
    PSA_ASSERT(psa_pake_set_peer(&server, spake2p_prover_client_id,
                                 sizeof(spake2p_prover_client_id)));
    PSA_ASSERT(psa_pake_set_context(&server, context->x, context->len));

    /* Server KEY_SHARE = shareV, with the published ephemeral y. */
    mbedtls_spake2p_test_injected_ephemeral = y->x;
    mbedtls_spake2p_test_injected_ephemeral_len = y->len;
    PSA_ASSERT(psa_pake_output(&server, PSA_PAKE_STEP_KEY_SHARE,
                               shareV, sizeof(shareV), &lv));
    TEST_MEMORY_COMPARE(shareV, lv, exp_shareV->x, exp_shareV->len);

exit:
    mbedtls_spake2p_test_injected_ephemeral = NULL;
    mbedtls_spake2p_test_injected_ephemeral_len = 0;
    psa_destroy_key(skey);
    psa_pake_abort(&server);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_verifier_key_share_format(int alg_arg, int bits_arg,
                                       int expected_len, data_t *server_key)
{
    /* psa_pake_output(KEY_SHARE) for the Verifier must emit an uncompressed
     * SEC1 point of the curve's fixed length, consistent with
     * PSA_PAKE_OUTPUT_SIZE(). */
    psa_algorithm_t alg = alg_arg;
    psa_pake_primitive_t prim = PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                   PSA_ECC_FAMILY_SECP_R1,
                                                   (uint32_t) bits_arg);
    psa_pake_operation_t server = psa_pake_operation_init_short();
    uint8_t shareV[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t lv = 0;

    PSA_INIT();

    TEST_EQUAL(PSA_PAKE_OUTPUT_SIZE(alg, prim, PSA_PAKE_STEP_KEY_SHARE),
               (size_t) expected_len);

    TEST_ASSERT(spake2p_setup_server(&server, alg, (uint32_t) bits_arg,
                                     server_key) == 1);

    PSA_ASSERT(psa_pake_output(&server, PSA_PAKE_STEP_KEY_SHARE,
                               shareV, sizeof(shareV), &lv));
    TEST_EQUAL(lv, (size_t) expected_len);
    TEST_EQUAL(shareV[0], 0x04);

exit:
    psa_pake_abort(&server);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_verifier_key_share_invalid(int alg_arg, int bits_arg,
                                        data_t *server_key,
                                        data_t *bad_share)
{
    /* An invalid peer key share (malformed encoding, wrong length, point at
     * infinity or an off-curve point) must be rejected by
     * psa_pake_input(KEY_SHARE) with PSA_ERROR_INVALID_ARGUMENT: "If the
     * validation of a key share fails, then the corresponding call to
     * psa_pake_input() for the PSA_PAKE_STEP_KEY_SHARE step will return
     * PSA_ERROR_INVALID_ARGUMENT" (PSA PAKE extension), implementing the
     * mandatory abort of RFC 9383 Section 6. */
    psa_algorithm_t alg = alg_arg;
    psa_pake_operation_t server = psa_pake_operation_init_short();

    PSA_INIT();

    TEST_ASSERT(spake2p_setup_server(&server, alg, (uint32_t) bits_arg,
                                     server_key) == 1);

    TEST_EQUAL(psa_pake_input(&server, PSA_PAKE_STEP_KEY_SHARE,
                              bad_share->x, bad_share->len),
               PSA_ERROR_INVALID_ARGUMENT);

exit:
    psa_pake_abort(&server);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SPAKE2P_HMAC:PSA_WANT_ALG_SHA_256:PSA_WANT_ECC_SECP_R1_256 */
void spake2p_setup_key_confirmation(int key_confirmation_arg,
                                    int expected_status_arg,
                                    data_t *client_key)
{
    /* Only PSA_PAKE_CONFIRMED_KEY is implemented for SPAKE2+:
     * psa_pake_setup() must fail for PSA_PAKE_UNCONFIRMED_KEY
     * (NOT_SUPPORTED) and for out-of-range values (INVALID_ARGUMENT). */
    psa_algorithm_t alg = PSA_ALG_SPAKE2P_HMAC(PSA_ALG_SHA_256);
    psa_pake_cipher_suite_t cs = psa_pake_cipher_suite_init();
    psa_pake_operation_t op = psa_pake_operation_init_short();
    psa_key_attributes_t attr = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t key = MBEDTLS_SVC_KEY_ID_INIT;

    PSA_INIT();

    psa_pake_cs_set_algorithm(&cs, alg);
    psa_pake_cs_set_primitive(&cs, PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                      PSA_ECC_FAMILY_SECP_R1, 256));
    psa_pake_cs_set_key_confirmation(&cs, (uint32_t) key_confirmation_arg);
    psa_set_key_usage_flags(&attr, PSA_KEY_USAGE_DERIVE);
    psa_set_key_algorithm(&attr, alg);
    psa_set_key_type(&attr, PSA_KEY_TYPE_SPAKE2P_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1));
    PSA_ASSERT(psa_import_key(&attr, client_key->x, client_key->len, &key));

    TEST_EQUAL(psa_pake_setup(&op, key, &cs), expected_status_arg);

exit:
    psa_destroy_key(key);
    psa_pake_abort(&op);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SPAKE2P_MATTER:PSA_WANT_ALG_SHA_256:PSA_WANT_ECC_SECP_R1_256:MBEDTLS_TEST_HOOKS */
void spake2p_verifier_confirm_psa_kat(data_t *context,
                                      data_t *client_key, data_t *server_key,
                                      data_t *x, data_t *y,
                                      data_t *exp_confirmV)
{
    /* Reproduce the RFC 9383 P-256 HMAC Verifier confirmation MAC (confirmV)
     * byte-for-byte through psa_pake_output(PSA_PAKE_STEP_CONFIRM), via
     * PSA_ALG_SPAKE2P_MATTER (the HMAC-SHA-256 P-256 profile). Both shares are
     * exchanged with the published ephemerals pinned through the
     * MBEDTLS_TEST_HOOKS injection seam; the server then outputs confirmV. The
     * Prover-side confirmation check and shared-key export are out of scope of
     * this slice. */
    psa_pake_cipher_suite_t cs = psa_pake_cipher_suite_init();
    psa_pake_operation_t client = psa_pake_operation_init_short();
    psa_pake_operation_t server = psa_pake_operation_init_short();
    psa_key_attributes_t ca = PSA_KEY_ATTRIBUTES_INIT;
    psa_key_attributes_t sa = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t ckey = MBEDTLS_SVC_KEY_ID_INIT;
    mbedtls_svc_key_id_t skey = MBEDTLS_SVC_KEY_ID_INIT;
    uint8_t shareP[PSA_PAKE_OUTPUT_MAX_SIZE];
    uint8_t shareV[PSA_PAKE_OUTPUT_MAX_SIZE];
    uint8_t confirm[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t lp = 0, lv = 0, lc = 0;

    PSA_INIT();

    psa_pake_cs_set_algorithm(&cs, PSA_ALG_SPAKE2P_MATTER);
    psa_pake_cs_set_primitive(&cs, PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                      PSA_ECC_FAMILY_SECP_R1, 256));

    psa_set_key_usage_flags(&ca, PSA_KEY_USAGE_DERIVE);
    psa_set_key_algorithm(&ca, PSA_ALG_SPAKE2P_MATTER);
    psa_set_key_type(&ca, PSA_KEY_TYPE_SPAKE2P_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1));
    PSA_ASSERT(psa_import_key(&ca, client_key->x, client_key->len, &ckey));

    psa_set_key_usage_flags(&sa, PSA_KEY_USAGE_DERIVE);
    psa_set_key_algorithm(&sa, PSA_ALG_SPAKE2P_MATTER);
    psa_set_key_type(&sa, PSA_KEY_TYPE_SPAKE2P_PUBLIC_KEY(PSA_ECC_FAMILY_SECP_R1));
    PSA_ASSERT(psa_import_key(&sa, server_key->x, server_key->len, &skey));

    PSA_ASSERT(psa_pake_setup(&client, ckey, &cs));
    PSA_ASSERT(psa_pake_set_role(&client, PSA_PAKE_ROLE_CLIENT));
    PSA_ASSERT(psa_pake_set_user(&client, spake2p_prover_client_id,
                                 sizeof(spake2p_prover_client_id)));
    PSA_ASSERT(psa_pake_set_peer(&client, spake2p_prover_server_id,
                                 sizeof(spake2p_prover_server_id)));
    PSA_ASSERT(psa_pake_set_context(&client, context->x, context->len));

    PSA_ASSERT(psa_pake_setup(&server, skey, &cs));
    PSA_ASSERT(psa_pake_set_role(&server, PSA_PAKE_ROLE_SERVER));
    PSA_ASSERT(psa_pake_set_user(&server, spake2p_prover_server_id,
                                 sizeof(spake2p_prover_server_id)));
    PSA_ASSERT(psa_pake_set_peer(&server, spake2p_prover_client_id,
                                 sizeof(spake2p_prover_client_id)));
    PSA_ASSERT(psa_pake_set_context(&server, context->x, context->len));

    /* Client KEY_SHARE = shareP, with the published ephemeral x. */
    mbedtls_spake2p_test_injected_ephemeral = x->x;
    mbedtls_spake2p_test_injected_ephemeral_len = x->len;
    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, sizeof(shareP), &lp));
    PSA_ASSERT(psa_pake_input(&server, PSA_PAKE_STEP_KEY_SHARE, shareP, lp));

    /* Server KEY_SHARE = shareV, with the published ephemeral y. */
    mbedtls_spake2p_test_injected_ephemeral = y->x;
    mbedtls_spake2p_test_injected_ephemeral_len = y->len;
    PSA_ASSERT(psa_pake_output(&server, PSA_PAKE_STEP_KEY_SHARE,
                               shareV, sizeof(shareV), &lv));
    PSA_ASSERT(psa_pake_input(&client, PSA_PAKE_STEP_KEY_SHARE, shareV, lv));

    /* Verifier confirmation MAC. */
    PSA_ASSERT(psa_pake_output(&server, PSA_PAKE_STEP_CONFIRM,
                               confirm, sizeof(confirm), &lc));
    TEST_MEMORY_COMPARE(confirm, lc, exp_confirmV->x, exp_confirmV->len);

exit:
    mbedtls_spake2p_test_injected_ephemeral = NULL;
    mbedtls_spake2p_test_injected_ephemeral_len = 0;
    psa_destroy_key(ckey);
    psa_destroy_key(skey);
    psa_pake_abort(&client);
    psa_pake_abort(&server);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SPAKE2P_HMAC:PSA_WANT_ALG_SHA_256:PSA_WANT_ECC_SECP_R1_256:MBEDTLS_TEST_HOOKS */
void spake2p_prover_confirm_psa_kat(data_t *context,
                                    data_t *client_key, data_t *server_key,
                                    data_t *x, data_t *y,
                                    data_t *exp_confirmP)
{
    /* Reproduce the RFC 9383 P-256 HMAC Prover confirmation MAC (confirmP)
     * byte-for-byte through psa_pake_output(PSA_PAKE_STEP_CONFIRM) on the
     * client, via PSA_ALG_SPAKE2P_HMAC (the HMAC-SHA-256 P-256 ciphersuite).
     * Both shares are exchanged with the published ephemerals pinned through
     * the MBEDTLS_TEST_HOOKS injection seam; the client then outputs confirmP.
     * The Verifier-side check of confirmP and shared-key export are out of
     * scope of this slice. */
    psa_pake_cipher_suite_t cs = psa_pake_cipher_suite_init();
    psa_pake_operation_t client = psa_pake_operation_init_short();
    psa_pake_operation_t server = psa_pake_operation_init_short();
    psa_key_attributes_t ca = PSA_KEY_ATTRIBUTES_INIT;
    psa_key_attributes_t sa = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t ckey = MBEDTLS_SVC_KEY_ID_INIT;
    mbedtls_svc_key_id_t skey = MBEDTLS_SVC_KEY_ID_INIT;
    uint8_t shareP[PSA_PAKE_OUTPUT_MAX_SIZE];
    uint8_t shareV[PSA_PAKE_OUTPUT_MAX_SIZE];
    uint8_t confirm[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t lp = 0, lv = 0, lc = 0;
    psa_algorithm_t alg = PSA_ALG_SPAKE2P_HMAC(PSA_ALG_SHA_256);

    PSA_INIT();

    psa_pake_cs_set_algorithm(&cs, alg);
    psa_pake_cs_set_primitive(&cs, PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                      PSA_ECC_FAMILY_SECP_R1, 256));

    psa_set_key_usage_flags(&ca, PSA_KEY_USAGE_DERIVE);
    psa_set_key_algorithm(&ca, alg);
    psa_set_key_type(&ca, PSA_KEY_TYPE_SPAKE2P_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1));
    PSA_ASSERT(psa_import_key(&ca, client_key->x, client_key->len, &ckey));

    psa_set_key_usage_flags(&sa, PSA_KEY_USAGE_DERIVE);
    psa_set_key_algorithm(&sa, alg);
    psa_set_key_type(&sa, PSA_KEY_TYPE_SPAKE2P_PUBLIC_KEY(PSA_ECC_FAMILY_SECP_R1));
    PSA_ASSERT(psa_import_key(&sa, server_key->x, server_key->len, &skey));

    PSA_ASSERT(psa_pake_setup(&client, ckey, &cs));
    PSA_ASSERT(psa_pake_set_role(&client, PSA_PAKE_ROLE_CLIENT));
    PSA_ASSERT(psa_pake_set_user(&client, spake2p_prover_client_id,
                                 sizeof(spake2p_prover_client_id)));
    PSA_ASSERT(psa_pake_set_peer(&client, spake2p_prover_server_id,
                                 sizeof(spake2p_prover_server_id)));
    PSA_ASSERT(psa_pake_set_context(&client, context->x, context->len));

    PSA_ASSERT(psa_pake_setup(&server, skey, &cs));
    PSA_ASSERT(psa_pake_set_role(&server, PSA_PAKE_ROLE_SERVER));
    PSA_ASSERT(psa_pake_set_user(&server, spake2p_prover_server_id,
                                 sizeof(spake2p_prover_server_id)));
    PSA_ASSERT(psa_pake_set_peer(&server, spake2p_prover_client_id,
                                 sizeof(spake2p_prover_client_id)));
    PSA_ASSERT(psa_pake_set_context(&server, context->x, context->len));

    /* Client KEY_SHARE = shareP, with the published ephemeral x. */
    mbedtls_spake2p_test_injected_ephemeral = x->x;
    mbedtls_spake2p_test_injected_ephemeral_len = x->len;
    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, sizeof(shareP), &lp));
    PSA_ASSERT(psa_pake_input(&server, PSA_PAKE_STEP_KEY_SHARE, shareP, lp));

    /* Server KEY_SHARE = shareV, with the published ephemeral y. */
    mbedtls_spake2p_test_injected_ephemeral = y->x;
    mbedtls_spake2p_test_injected_ephemeral_len = y->len;
    PSA_ASSERT(psa_pake_output(&server, PSA_PAKE_STEP_KEY_SHARE,
                               shareV, sizeof(shareV), &lv));
    PSA_ASSERT(psa_pake_input(&client, PSA_PAKE_STEP_KEY_SHARE, shareV, lv));

    /* Prover confirmation MAC. */
    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_CONFIRM,
                               confirm, sizeof(confirm), &lc));
    TEST_MEMORY_COMPARE(confirm, lc, exp_confirmP->x, exp_confirmP->len);

exit:
    mbedtls_spake2p_test_injected_ephemeral = NULL;
    mbedtls_spake2p_test_injected_ephemeral_len = 0;
    psa_destroy_key(ckey);
    psa_destroy_key(skey);
    psa_pake_abort(&client);
    psa_pake_abort(&server);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SPAKE2P_HMAC:PSA_WANT_ALG_SHA_256:PSA_WANT_ECC_SECP_R1_256:MBEDTLS_TEST_HOOKS */
void spake2p_prover_confirm_input_psa_kat(data_t *context,
                                          data_t *client_key, data_t *x,
                                          data_t *peer_shareV,
                                          data_t *confirmV)
{
    /* Drive the Prover (client) through the PSA PAKE API up to and including
     * psa_pake_input(PSA_PAKE_STEP_CONFIRM): with the published ephemeral x
     * pinned through the MBEDTLS_TEST_HOOKS injection seam, the client outputs
     * its share, reads the verifier's share (peer_shareV) and then verifies the
     * RFC 9383 Appendix C confirmation MAC (confirmV). A correct confirmV is
     * accepted; a confirmV with a single flipped byte is rejected with
     * PSA_ERROR_INVALID_SIGNATURE. Uses the HMAC-SHA-256 P-256 ciphersuite. */
    psa_pake_cipher_suite_t cs = psa_pake_cipher_suite_init();
    psa_pake_operation_t client = psa_pake_operation_init_short();
    psa_key_attributes_t ca = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t ckey = MBEDTLS_SVC_KEY_ID_INIT;
    uint8_t shareP[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t lp = 0;
    psa_algorithm_t alg = PSA_ALG_SPAKE2P_HMAC(PSA_ALG_SHA_256);

    PSA_INIT();

    psa_pake_cs_set_algorithm(&cs, alg);
    psa_pake_cs_set_primitive(&cs, PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                      PSA_ECC_FAMILY_SECP_R1, 256));

    psa_set_key_usage_flags(&ca, PSA_KEY_USAGE_DERIVE);
    psa_set_key_algorithm(&ca, alg);
    psa_set_key_type(&ca, PSA_KEY_TYPE_SPAKE2P_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1));
    PSA_ASSERT(psa_import_key(&ca, client_key->x, client_key->len, &ckey));

    PSA_ASSERT(psa_pake_setup(&client, ckey, &cs));
    PSA_ASSERT(psa_pake_set_role(&client, PSA_PAKE_ROLE_CLIENT));
    PSA_ASSERT(psa_pake_set_user(&client, spake2p_prover_client_id,
                                 sizeof(spake2p_prover_client_id)));
    PSA_ASSERT(psa_pake_set_peer(&client, spake2p_prover_server_id,
                                 sizeof(spake2p_prover_server_id)));
    PSA_ASSERT(psa_pake_set_context(&client, context->x, context->len));

    /* Client KEY_SHARE = shareP, with the published ephemeral x. */
    mbedtls_spake2p_test_injected_ephemeral = x->x;
    mbedtls_spake2p_test_injected_ephemeral_len = x->len;
    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, sizeof(shareP), &lp));

    /* Read the verifier's share. */
    PSA_ASSERT(psa_pake_input(&client, PSA_PAKE_STEP_KEY_SHARE,
                              peer_shareV->x, peer_shareV->len));

    /* The prover accepts the verifier's RFC 9383 confirmV. */
    PSA_ASSERT(psa_pake_input(&client, PSA_PAKE_STEP_CONFIRM,
                              confirmV->x, confirmV->len));

exit:
    mbedtls_spake2p_test_injected_ephemeral = NULL;
    mbedtls_spake2p_test_injected_ephemeral_len = 0;
    psa_destroy_key(ckey);
    psa_pake_abort(&client);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SPAKE2P_HMAC:PSA_WANT_ALG_SHA_256:PSA_WANT_ECC_SECP_R1_256:MBEDTLS_TEST_HOOKS */
void spake2p_prover_confirm_input_tampered(data_t *context,
                                           data_t *client_key, data_t *x,
                                           data_t *peer_shareV,
                                           data_t *confirmV)
{
    /* As above, but feed a confirmV with a single flipped byte to
     * psa_pake_input(PSA_PAKE_STEP_CONFIRM): the constant-time MAC check must
     * fail and the failure must surface as PSA_ERROR_INVALID_SIGNATURE. */
    psa_pake_cipher_suite_t cs = psa_pake_cipher_suite_init();
    psa_pake_operation_t client = psa_pake_operation_init_short();
    psa_key_attributes_t ca = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t ckey = MBEDTLS_SVC_KEY_ID_INIT;
    uint8_t shareP[PSA_PAKE_OUTPUT_MAX_SIZE];
    uint8_t *tampered = NULL;
    size_t lp = 0;
    psa_algorithm_t alg = PSA_ALG_SPAKE2P_HMAC(PSA_ALG_SHA_256);

    PSA_INIT();

    psa_pake_cs_set_algorithm(&cs, alg);
    psa_pake_cs_set_primitive(&cs, PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                      PSA_ECC_FAMILY_SECP_R1, 256));

    psa_set_key_usage_flags(&ca, PSA_KEY_USAGE_DERIVE);
    psa_set_key_algorithm(&ca, alg);
    psa_set_key_type(&ca, PSA_KEY_TYPE_SPAKE2P_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1));
    PSA_ASSERT(psa_import_key(&ca, client_key->x, client_key->len, &ckey));

    PSA_ASSERT(psa_pake_setup(&client, ckey, &cs));
    PSA_ASSERT(psa_pake_set_role(&client, PSA_PAKE_ROLE_CLIENT));
    PSA_ASSERT(psa_pake_set_user(&client, spake2p_prover_client_id,
                                 sizeof(spake2p_prover_client_id)));
    PSA_ASSERT(psa_pake_set_peer(&client, spake2p_prover_server_id,
                                 sizeof(spake2p_prover_server_id)));
    PSA_ASSERT(psa_pake_set_context(&client, context->x, context->len));

    mbedtls_spake2p_test_injected_ephemeral = x->x;
    mbedtls_spake2p_test_injected_ephemeral_len = x->len;
    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, sizeof(shareP), &lp));
    PSA_ASSERT(psa_pake_input(&client, PSA_PAKE_STEP_KEY_SHARE,
                              peer_shareV->x, peer_shareV->len));

    TEST_CALLOC(tampered, confirmV->len);
    memcpy(tampered, confirmV->x, confirmV->len);
    tampered[0] ^= 0x01;
    TEST_EQUAL(psa_pake_input(&client, PSA_PAKE_STEP_CONFIRM,
                              tampered, confirmV->len),
               PSA_ERROR_INVALID_SIGNATURE);

exit:
    mbedtls_spake2p_test_injected_ephemeral = NULL;
    mbedtls_spake2p_test_injected_ephemeral_len = 0;
    mbedtls_free(tampered);
    psa_destroy_key(ckey);
    psa_pake_abort(&client);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_setup_key_mismatch(int suite_alg_arg, int bits_arg,
                                int key_type_arg, int key_alg_arg,
                                data_t *key_data, int expected_status_arg)
{
    /* psa_pake_setup() must reject a password key whose type or size is not
     * compatible with the cipher suite: only SPAKE2+ keys on the cipher
     * suite's curve are valid for a SPAKE2+ algorithm, and SPAKE2+ keys are
     * not valid for other PAKE algorithms. */
    psa_pake_cipher_suite_t cs = psa_pake_cipher_suite_init();
    psa_pake_operation_t op = psa_pake_operation_init_short();
    psa_key_attributes_t attr = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t key = MBEDTLS_SVC_KEY_ID_INIT;

    PSA_INIT();

    psa_pake_cs_set_algorithm(&cs, (psa_algorithm_t) suite_alg_arg);
    psa_pake_cs_set_primitive(&cs, PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                      PSA_ECC_FAMILY_SECP_R1,
                                                      (uint32_t) bits_arg));
    psa_set_key_usage_flags(&attr, PSA_KEY_USAGE_DERIVE);
    psa_set_key_algorithm(&attr, (psa_algorithm_t) key_alg_arg);
    psa_set_key_type(&attr, (psa_key_type_t) key_type_arg);
    PSA_ASSERT(psa_import_key(&attr, key_data->x, key_data->len, &key));

    TEST_EQUAL(psa_pake_setup(&op, key, &cs), expected_status_arg);

exit:
    psa_destroy_key(key);
    psa_pake_abort(&op);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_verifier_confirm_too_early(int alg_arg, int bits_arg,
                                        data_t *server_key)
{
    /* The Verifier must not be able to output a confirmation MAC before the key
     * shares have been exchanged: psa_pake_output(PSA_PAKE_STEP_CONFIRM) in the
     * key-share round is a state error. */
    psa_algorithm_t alg = alg_arg;
    psa_pake_operation_t server = psa_pake_operation_init_short();
    uint8_t confirm[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t lc = 0;

    PSA_INIT();

    TEST_ASSERT(spake2p_setup_server(&server, alg, (uint32_t) bits_arg,
                                     server_key) == 1);

    TEST_EQUAL(psa_pake_output(&server, PSA_PAKE_STEP_CONFIRM,
                               confirm, sizeof(confirm), &lc),
               PSA_ERROR_BAD_STATE);

exit:
    psa_pake_abort(&server);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_prover_confirm_output_too_early(int alg_arg, int bits_arg,
                                             data_t *client_key)
{
    /* The Prover must not be able to output a confirmation MAC before the key
     * shares have been exchanged: psa_pake_output(PSA_PAKE_STEP_CONFIRM) in the
     * key-share round is a state error. */
    psa_algorithm_t alg = alg_arg;
    psa_pake_operation_t client = psa_pake_operation_init_short();
    uint8_t confirm[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t lc = 0;

    PSA_INIT();

    TEST_ASSERT(spake2p_setup_client(&client, alg, (uint32_t) bits_arg,
                                     client_key) == 1);

    TEST_EQUAL(psa_pake_output(&client, PSA_PAKE_STEP_CONFIRM,
                               confirm, sizeof(confirm), &lc),
               PSA_ERROR_BAD_STATE);

exit:
    psa_pake_abort(&client);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_prover_input_confirm_too_early(int alg_arg, int bits_arg,
                                            data_t *client_key)
{
    /* The Prover must not be able to consume a confirmation MAC before the key
     * shares have been exchanged: psa_pake_input(PSA_PAKE_STEP_CONFIRM) while
     * the operation is still in the key-share round is a state error. */
    psa_algorithm_t alg = alg_arg;
    psa_pake_primitive_t prim =
        PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC, PSA_ECC_FAMILY_SECP_R1,
                           (uint32_t) bits_arg);
    /* A well-formed CONFIRM input length, so the operation reaches the state
     * check rather than failing argument validation first. */
    size_t confirm_len = PSA_PAKE_INPUT_SIZE(alg, prim, PSA_PAKE_STEP_CONFIRM);
    psa_pake_operation_t client = psa_pake_operation_init_short();
    uint8_t confirm[PSA_PAKE_OUTPUT_MAX_SIZE] = { 0 };

    PSA_INIT();

    TEST_ASSERT(spake2p_setup_client(&client, alg, (uint32_t) bits_arg,
                                     client_key) == 1);

    TEST_EQUAL(psa_pake_input(&client, PSA_PAKE_STEP_CONFIRM,
                              confirm, confirm_len),
               PSA_ERROR_BAD_STATE);

exit:
    psa_pake_abort(&client);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SPAKE2P_MATTER:PSA_WANT_ALG_SHA_256:PSA_WANT_ECC_SECP_R1_256:MBEDTLS_TEST_HOOKS */
void spake2p_prover_second_input_key_share(data_t *context,
                                           data_t *client_key, data_t *x,
                                           data_t *peer_shareV)
{
    /* The Prover transfers exactly one key share in each direction. After its
     * own output(KEY_SHARE) and a single input(KEY_SHARE) of the verifier's
     * share, a second input(KEY_SHARE) in the same exchange is a state error:
     * the SPAKE2+ state machine rejects a repeated input within one exchange. */
    psa_pake_cipher_suite_t cs = psa_pake_cipher_suite_init();
    psa_pake_operation_t client = psa_pake_operation_init_short();
    psa_key_attributes_t ca = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t ckey = MBEDTLS_SVC_KEY_ID_INIT;
    uint8_t shareP[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t lp = 0;

    PSA_INIT();

    psa_pake_cs_set_algorithm(&cs, PSA_ALG_SPAKE2P_MATTER);
    psa_pake_cs_set_primitive(&cs, PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                      PSA_ECC_FAMILY_SECP_R1, 256));

    psa_set_key_usage_flags(&ca, PSA_KEY_USAGE_DERIVE);
    psa_set_key_algorithm(&ca, PSA_ALG_SPAKE2P_MATTER);
    psa_set_key_type(&ca, PSA_KEY_TYPE_SPAKE2P_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1));
    PSA_ASSERT(psa_import_key(&ca, client_key->x, client_key->len, &ckey));

    PSA_ASSERT(psa_pake_setup(&client, ckey, &cs));
    PSA_ASSERT(psa_pake_set_role(&client, PSA_PAKE_ROLE_CLIENT));
    PSA_ASSERT(psa_pake_set_user(&client, spake2p_prover_client_id,
                                 sizeof(spake2p_prover_client_id)));
    PSA_ASSERT(psa_pake_set_peer(&client, spake2p_prover_server_id,
                                 sizeof(spake2p_prover_server_id)));
    PSA_ASSERT(psa_pake_set_context(&client, context->x, context->len));

    /* Client KEY_SHARE = shareP, with the published ephemeral x. */
    mbedtls_spake2p_test_injected_ephemeral = x->x;
    mbedtls_spake2p_test_injected_ephemeral_len = x->len;
    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, sizeof(shareP), &lp));

    /* First input of the verifier's share completes the exchange. */
    PSA_ASSERT(psa_pake_input(&client, PSA_PAKE_STEP_KEY_SHARE,
                              peer_shareV->x, peer_shareV->len));

    /* A second KEY_SHARE input is out of order. */
    TEST_EQUAL(psa_pake_input(&client, PSA_PAKE_STEP_KEY_SHARE,
                              peer_shareV->x, peer_shareV->len),
               PSA_ERROR_BAD_STATE);

exit:
    mbedtls_spake2p_test_injected_ephemeral = NULL;
    mbedtls_spake2p_test_injected_ephemeral_len = 0;
    psa_destroy_key(ckey);
    psa_pake_abort(&client);
    PSA_DONE();
}
/* END_CASE */
