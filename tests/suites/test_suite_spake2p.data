# SPAKE2+ Prover key-share known-answer tests with a fixed ephemeral scalar,
# injected through the MBEDTLS_TEST_HOOKS-only seam
# mbedtls_spake2p_write_key_share_with_ephemeral().
#
# Arguments: curve, hash, mac, context, idProver, idVerifier, client key
# (w0||w1), x, expected shareP.
#
# Every row is an official RFC 9383 Appendix C test vector (trusted, third
# party): the HMAC ciphersuites the RFC defines over P-256/P-384/P-521.

SPAKE2+ Prover key-share KAT P-256 HMAC-SHA256 (RFC 9383 Appendix C)
depends_on:MBEDTLS_ECP_DP_SECP256R1_ENABLED:PSA_WANT_ALG_SHA_256
spake2p_prover_key_share_kat:MBEDTLS_ECP_DP_SECP256R1:MBEDTLS_MD_SHA256:MBEDTLS_SPAKE2P_MAC_HMAC:"5350414b45322b2d503235362d5348413235362d484b44462d5348413235362d484d41432d534841323536205465737420566563746f7273":"636c69656e74":"736572766572":"bb8e1bbcf3c48f62c08db243652ae55d3e5586053fca77102994f23ad95491b37e945f34d78785b8a3ef44d0df5a1a97d6b3b460409a345ca7830387a74b1dba":"d1232c8e8693d02368976c174e2088851b8365d0d79a9eee709c6a05a2fad539":"04ef3bd051bf78a2234ec0df197f7828060fe9856503579bb1733009042c15c0c1de127727f418b5966afadfdd95a6e4591d171056b333dab97a79c7193e341727"

