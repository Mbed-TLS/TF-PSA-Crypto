spake2p_prover_key_share_kat:MBEDTLS_ECP_DP_SECP384R1:MBEDTLS_MD_SHA256:MBEDTLS_SPAKE2P_MAC_HMAC:"5350414b45322b2d503338342d5348413235362d484b44462d5348413235362d484d41432d534841323536205465737420566563746f7273":"636c69656e74":"736572766572":"097a61cbb1cee72bb654be96d80f46e0e3531151003903b572fc193f233772c23c22228884a0d5447d0ab49a656ce1d218772816140e6c3c3938a693c600b2191118a34c7956e1f1cd5b0d519b56ea5858060966cfaf27679c9182129949e74f":"2f1bdbeda162ff2beba0293d3cd3ae95f663c53663378c7e18ee8f56a4a48b00d31ce0ef43606548da485058f12e8e73":"049fb0404ca7ce71fb85d3aaa8fd05fa054affac996135bc245149be09571e43e2bf76e00d6d52ac452b8224f6b9da31420a4f5e214b377546daad4d61da5ca0cfdea59a5a92ebdb6b42da5d14663b8d1f9eb97050139ab89788e0ada27b048fcf"

SPAKE2+ Prover key-share KAT P-521 HMAC-SHA512 (RFC 9383 Appendix C)
depends_on:MBEDTLS_ECP_DP_SECP521R1_ENABLED:PSA_WANT_ALG_SHA_512
spake2p_prover_key_share_kat:MBEDTLS_ECP_DP_SECP521R1:MBEDTLS_MD_SHA512:MBEDTLS_SPAKE2P_MAC_HMAC:"5350414b45322b2d503532312d5348413531322d484b44462d5348413531322d484d41432d534841353132205465737420566563746f7273":"636c69656e74":"736572766572":"009c79bcd7656716314fca5a6e2c5cda7ef86131399438e012a043051e863f60b5aeb3c101731e1505e721580f48535a9b0456b231b9266ae6fff49ee90d25f72f5f01632c15f51fcd916cd79e19075f8a69b72b0099922ad62ff8d540b469569f0aa027047aed2b3f242ea0ac4288b4e4db6a4e5946d8ad32b42192c5aa66d9ef8e1b33":"00b69e3bb15df82c9fa0057461334e2c66ab92fc9b8d3662eec81216ef5ddc4a43f19e90dedaa2d72502f69673a115984ffcf88e03a9364b07102114c5602cd93c69":"0400a14431edf6852ff5fe868f8683e16e9e0a45d9e27f9a96442285ac6b161fc0bf267362a5ffb06f9cbd14b7a37e492146d77cae4c77812df00a91dbae09e27e1fac00ae019317ef9768548325bca35ce258e6206fe03c6338b2eb889d09d9f11400a36cf6328a7e1f81c6c7a2af7ff1d9b5210768318f27e57b75b39b9fbfc7b37a60ab"

# Setup negatives: bad role / unsupported curve / wrong key length.

SPAKE2+ setup rejects key of wrong length (P-256 HMAC)
spake2p_setup_negative:MBEDTLS_ECP_DP_SECP256R1:MBEDTLS_MD_SHA256:MBEDTLS_SPAKE2P_MAC_HMAC:"bb8e1bbcf3c48f62c08db243652ae55d3e5586053fca77102994f23ad95491b3":MBEDTLS_ERR_ECP_BAD_INPUT_DATA

SPAKE2+ setup rejects unsupported curve (Curve25519)
spake2p_setup_negative:MBEDTLS_ECP_DP_CURVE25519:MBEDTLS_MD_SHA256:MBEDTLS_SPAKE2P_MAC_HMAC:"bb8e1bbcf3c48f62c08db243652ae55d3e5586053fca77102994f23ad95491b37e945f34d78785b8a3ef44d0df5a1a97d6b3b460409a345ca7830387a74b1dba":MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE

# Prover key-share output rejects too-small buffer (P-256 HMAC).

SPAKE2+ Prover key-share buffer too small (P-256)
spake2p_prover_share_buffer_too_small:"bb8e1bbcf3c48f62c08db243652ae55d3e5586053fca77102994f23ad95491b37e945f34d78785b8a3ef44d0df5a1a97d6b3b460409a345ca7830387a74b1dba":"d1232c8e8693d02368976c174e2088851b8365d0d79a9eee709c6a05a2fad539"
