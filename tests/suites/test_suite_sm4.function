/* BEGIN_HEADER */
#include "mbedtls/private/sm4.h"
/* END_HEADER */

/* BEGIN_DEPENDENCIES
 * depends_on:MBEDTLS_SM4_C
 * END_DEPENDENCIES */

/* BEGIN_CASE */
void sm4_invalid_param()
{
    mbedtls_sm4_context ctx;
    unsigned char buf[16] = { 0 };
    const int invalid_mode = 42;

    TEST_EQUAL(MBEDTLS_ERR_SM4_BAD_INPUT_DATA,
               mbedtls_sm4_crypt_ecb(&ctx,
                                     invalid_mode,
                                     buf, buf));
}
/* END_CASE */

/* BEGIN_CASE */
void sm4_encrypt_ecb()
{
    mbedtls_sm4_context ctx;
    unsigned char key[16] = {
        0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef,
        0xfe, 0xdc, 0xba, 0x98, 0x76, 0x54, 0x32, 0x10
    };
    unsigned char pt[16] = {
        0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef,
        0xfe, 0xdc, 0xba, 0x98, 0x76, 0x54, 0x32, 0x10
    };
    unsigned char expected_ct[16] = {
        0x68, 0x1e, 0xdf, 0x34, 0xd2, 0x06, 0x96, 0x5e,
        0x86, 0xb3, 0xe9, 0x4f, 0x53, 0x6e, 0x42, 0x46
    };
    unsigned char out[16];

    TEST_EQUAL(0, mbedtls_sm4_setkey_enc(&ctx, key));
    TEST_EQUAL(0, mbedtls_sm4_crypt_ecb(&ctx, MBEDTLS_SM4_ENCRYPT, pt, out));
    TEST_MEMORY_COMPARE(expected_ct, 16, out, 16);

    TEST_EQUAL(0, mbedtls_sm4_setkey_dec(&ctx, key));
    TEST_EQUAL(0, mbedtls_sm4_crypt_ecb(&ctx, MBEDTLS_SM4_DECRYPT, out, out));
    TEST_MEMORY_COMPARE(pt, 16, out, 16);

exit:
    mbedtls_sm4_free(&ctx);
}
/* END_CASE */

/* BEGIN_CASE */
void sm4_self_test()
{
    TEST_EQUAL(0, mbedtls_sm4_self_test(0));
}
/* END_CASE */
