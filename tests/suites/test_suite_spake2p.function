/* BEGIN_HEADER */
#include "mbedtls/private/spake2p.h"
#include "spake2p_invasive.h"

/* Deterministic RNG for the blinding of the constant-time scalar
 * multiplications. The KAT output is a deterministic function of the inputs and
 * does not depend on these bytes, so any stream is fine; a fixed sequence keeps
 * the test reproducible. */
static int spake2p_kat_rng(void *p, unsigned char *out, size_t len)
{
    uint32_t *state = (uint32_t *) p;
    for (size_t i = 0; i < len; i++) {
        *state = *state * 1103515245u + 12345u;
        out[i] = (unsigned char) (*state >> 16);
    }
    return 0;
}
/* END_HEADER */

/* BEGIN_DEPENDENCIES
 * depends_on:MBEDTLS_SPAKE2P_C
 * END_DEPENDENCIES
 */

/* BEGIN_CASE depends_on:MBEDTLS_TEST_HOOKS */
void spake2p_prover_key_share_kat(int curve_arg, int hash_arg, int mac_arg,
                                  data_t *context, data_t *prover_id,
                                  data_t *verifier_id, data_t *client_key,
                                  data_t *x, data_t *exp_shareP)
{
    /* Known-answer test for the Prover side of write_key_share:
     * shareP = x*P + w0*M with the RFC 9383 fixed ephemeral x. */
    mbedtls_ecp_group_id curve = curve_arg;
    mbedtls_md_type_t hash = hash_arg;
    mbedtls_spake2p_mac_type mac = mac_arg;
    mbedtls_spake2p_context cli;
    unsigned char shareP[MBEDTLS_ECP_MAX_PT_LEN];
    size_t lenP;
    uint32_t rng_cli = 0x00c0ffeeu;

    mbedtls_spake2p_init(&cli);
    PSA_INIT();

    TEST_EQUAL(mbedtls_spake2p_setup(&cli, MBEDTLS_SPAKE2P_CLIENT, hash, mac,
                                     MBEDTLS_SPAKE2P_KDF_RFC9383,
                                     curve, client_key->x, client_key->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_context(&cli, context->x, context->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_user(&cli, prover_id->x, prover_id->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_peer(&cli, verifier_id->x,
                                        verifier_id->len), 0);
    TEST_EQUAL(mbedtls_spake2p_write_key_share_with_ephemeral(
                   &cli, x->x, x->len, shareP, sizeof(shareP), &lenP,
                   spake2p_kat_rng, &rng_cli), 0);
    TEST_MEMORY_COMPARE(shareP, lenP, exp_shareP->x, exp_shareP->len);

exit:
    mbedtls_spake2p_free(&cli);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_TEST_HOOKS */
void spake2p_verifier_key_share_kat(int curve_arg, int hash_arg, int mac_arg,
                                    data_t *context, data_t *prover_id,
                                    data_t *verifier_id, data_t *server_key,
                                    data_t *y, data_t *exp_shareV)
{
    /* Known-answer test for the Verifier side of write_key_share:
     * shareV = y*P + w0*N with the RFC 9383 fixed ephemeral y. The server is
     * set up from the public-key registration record server_key = w0||L. */
    mbedtls_ecp_group_id curve = curve_arg;
    mbedtls_md_type_t hash = hash_arg;
    mbedtls_spake2p_mac_type mac = mac_arg;
    mbedtls_spake2p_context srv;
    unsigned char shareV[MBEDTLS_ECP_MAX_PT_LEN];
    size_t lenV;
    uint32_t rng_srv = 0x00c0ffeeu;

    mbedtls_spake2p_init(&srv);
    PSA_INIT();

    TEST_EQUAL(mbedtls_spake2p_setup(&srv, MBEDTLS_SPAKE2P_SERVER, hash, mac,
                                     MBEDTLS_SPAKE2P_KDF_RFC9383,
                                     curve, server_key->x, server_key->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_context(&srv, context->x, context->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_user(&srv, verifier_id->x,
                                        verifier_id->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_peer(&srv, prover_id->x, prover_id->len), 0);
    TEST_EQUAL(mbedtls_spake2p_write_key_share_with_ephemeral(
                   &srv, y->x, y->len, shareV, sizeof(shareV), &lenV,
                   spake2p_kat_rng, &rng_srv), 0);
    TEST_MEMORY_COMPARE(shareV, lenV, exp_shareV->x, exp_shareV->len);

exit:
    mbedtls_spake2p_free(&srv);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_TEST_HOOKS */
void spake2p_verifier_transcript_hash_kat(int curve_arg, int hash_arg,
                                          int mac_arg, data_t *context,
                                          data_t *prover_id, data_t *verifier_id,
                                          data_t *server_key, data_t *y,
                                          data_t *peer_shareP,
                                          data_t *exp_tt_prefix)
{
    /* Known-answer test for the Verifier (server) transcript hash. After the
     * verifier writes its own share (shareV, from the fixed ephemeral y) and
     * reads the prover's share (shareP), the share-derivable prefix of the
     * RFC 9383 Section 3.3 transcript TT -- the length-prefixed concatenation
     * of Context, idProver, idVerifier, M, N, shareP, shareV -- is hashed.
     * exp_tt_prefix is that Hash(prefix), cross-checked against the RFC 9383
     * Appendix C field encoding. */
    mbedtls_ecp_group_id curve = curve_arg;
    mbedtls_md_type_t hash = hash_arg;
    mbedtls_spake2p_mac_type mac = mac_arg;
    mbedtls_spake2p_context srv;
    unsigned char shareV[MBEDTLS_ECP_MAX_PT_LEN];
    unsigned char tt[MBEDTLS_MD_MAX_SIZE];
    size_t lenV, tt_len;
    uint32_t rng_srv = 0x00c0ffeeu;

    mbedtls_spake2p_init(&srv);
    PSA_INIT();

    TEST_EQUAL(mbedtls_spake2p_setup(&srv, MBEDTLS_SPAKE2P_SERVER, hash, mac,
                                     MBEDTLS_SPAKE2P_KDF_RFC9383,
                                     curve, server_key->x, server_key->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_context(&srv, context->x, context->len), 0);
    /* For the server, set_user is idVerifier and set_peer is idProver. */
    TEST_EQUAL(mbedtls_spake2p_set_user(&srv, verifier_id->x,
                                        verifier_id->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_peer(&srv, prover_id->x, prover_id->len), 0);

    /* Transcript is not available until both shares are exchanged. */
    TEST_ASSERT(mbedtls_spake2p_test_get_transcript_prefix_hash(
                    &srv, tt, sizeof(tt), &tt_len) != 0);

    TEST_EQUAL(mbedtls_spake2p_write_key_share_with_ephemeral(
                   &srv, y->x, y->len, shareV, sizeof(shareV), &lenV,
                   spake2p_kat_rng, &rng_srv), 0);

    /* Still incomplete after our own share alone. */
    TEST_ASSERT(mbedtls_spake2p_test_get_transcript_prefix_hash(
                    &srv, tt, sizeof(tt), &tt_len) != 0);

    TEST_EQUAL(mbedtls_spake2p_read_key_share(&srv, peer_shareP->x,
                                              peer_shareP->len,
                                              spake2p_kat_rng, &rng_srv), 0);

    TEST_EQUAL(mbedtls_spake2p_test_get_transcript_prefix_hash(
                   &srv, tt, sizeof(tt), &tt_len), 0);
    TEST_MEMORY_COMPARE(tt, tt_len, exp_tt_prefix->x, exp_tt_prefix->len);

exit:
    mbedtls_spake2p_free(&srv);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_TEST_HOOKS */
void spake2p_prover_transcript_hash_kat(int curve_arg, int hash_arg,
                                        int mac_arg, data_t *context,
                                        data_t *prover_id, data_t *verifier_id,
                                        data_t *client_key, data_t *x,
                                        data_t *peer_shareV,
                                        data_t *exp_tt_prefix)
{
    /* Known-answer test for the Prover (client) transcript hash. After the
     * prover writes its own share (shareP, from the fixed ephemeral x) and
     * reads the verifier's share (shareV), the share-derivable prefix of the
     * RFC 9383 Section 3.3 transcript TT -- the length-prefixed concatenation
     * of Context, idProver, idVerifier, M, N, shareP, shareV -- is hashed. The
     * client and server compute the SAME TT, so exp_tt_prefix is the very value
     * cross-checked in the Verifier transcript KAT against RFC 9383 Appendix C. */
    mbedtls_ecp_group_id curve = curve_arg;
    mbedtls_md_type_t hash = hash_arg;
    mbedtls_spake2p_mac_type mac = mac_arg;
    mbedtls_spake2p_context cli;
    unsigned char shareP[MBEDTLS_ECP_MAX_PT_LEN];
    unsigned char tt[MBEDTLS_MD_MAX_SIZE];
    size_t lenP, tt_len;
    uint32_t rng_cli = 0x00c0ffeeu;

    mbedtls_spake2p_init(&cli);
    PSA_INIT();

    TEST_EQUAL(mbedtls_spake2p_setup(&cli, MBEDTLS_SPAKE2P_CLIENT, hash, mac,
                                     MBEDTLS_SPAKE2P_KDF_RFC9383,
                                     curve, client_key->x, client_key->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_context(&cli, context->x, context->len), 0);
    /* For the client, set_user is idProver and set_peer is idVerifier. */
    TEST_EQUAL(mbedtls_spake2p_set_user(&cli, prover_id->x,
                                        prover_id->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_peer(&cli, verifier_id->x,
                                        verifier_id->len), 0);

    /* Transcript is not available until both shares are exchanged. */
    TEST_ASSERT(mbedtls_spake2p_test_get_transcript_prefix_hash(
                    &cli, tt, sizeof(tt), &tt_len) != 0);

    TEST_EQUAL(mbedtls_spake2p_write_key_share_with_ephemeral(
                   &cli, x->x, x->len, shareP, sizeof(shareP), &lenP,
                   spake2p_kat_rng, &rng_cli), 0);

    /* Still incomplete after our own share alone. */
    TEST_ASSERT(mbedtls_spake2p_test_get_transcript_prefix_hash(
                    &cli, tt, sizeof(tt), &tt_len) != 0);

    TEST_EQUAL(mbedtls_spake2p_read_key_share(&cli, peer_shareV->x,
                                              peer_shareV->len,
                                              spake2p_kat_rng, &rng_cli), 0);

    TEST_EQUAL(mbedtls_spake2p_test_get_transcript_prefix_hash(
                   &cli, tt, sizeof(tt), &tt_len), 0);
    TEST_MEMORY_COMPARE(tt, tt_len, exp_tt_prefix->x, exp_tt_prefix->len);

exit:
    mbedtls_spake2p_free(&cli);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_TEST_HOOKS */
void spake2p_verifier_confirm_kat(int curve_arg, int hash_arg, int mac_arg,
                                  data_t *context, data_t *prover_id,
                                  data_t *verifier_id, data_t *server_key,
                                  data_t *y, data_t *peer_shareP,
                                  data_t *exp_confirmV)
{
    /* Known-answer test for the Verifier (server) confirmation MAC. After the
     * verifier writes its own share (shareV, from the fixed ephemeral y) and
     * reads the prover's share (shareP), the key schedule (RFC 9383 Section
     * 3.3-3.4) is fully determined, so confirmV = MAC(K_confirmV, shareP) is a
     * function of the two shares alone. exp_confirmV is the RFC 9383 Appendix C
     * value. */
    mbedtls_ecp_group_id curve = curve_arg;
    mbedtls_md_type_t hash = hash_arg;
    mbedtls_spake2p_mac_type mac = mac_arg;
    mbedtls_spake2p_context srv;
    unsigned char shareV[MBEDTLS_ECP_MAX_PT_LEN];
    unsigned char confirmV[MBEDTLS_MD_MAX_SIZE];
    size_t lenV, clenV;
    uint32_t rng_srv = 0x00c0ffeeu;

    mbedtls_spake2p_init(&srv);
    PSA_INIT();

    TEST_EQUAL(mbedtls_spake2p_setup(&srv, MBEDTLS_SPAKE2P_SERVER, hash, mac,
                                     MBEDTLS_SPAKE2P_KDF_RFC9383,
                                     curve, server_key->x, server_key->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_context(&srv, context->x, context->len), 0);
    /* For the server, set_user is idVerifier and set_peer is idProver. */
    TEST_EQUAL(mbedtls_spake2p_set_user(&srv, verifier_id->x,
                                        verifier_id->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_peer(&srv, prover_id->x, prover_id->len), 0);

    /* Confirmation is not available until the key schedule is derived, i.e.
     * before both shares have been exchanged. */
    TEST_EQUAL(mbedtls_spake2p_write_confirm(&srv, confirmV, sizeof(confirmV),
                                             &clenV),
               MBEDTLS_ERR_ECP_BAD_INPUT_DATA);

    TEST_EQUAL(mbedtls_spake2p_write_key_share_with_ephemeral(
                   &srv, y->x, y->len, shareV, sizeof(shareV), &lenV,
                   spake2p_kat_rng, &rng_srv), 0);

    /* Still incomplete after our own share alone. */
    TEST_EQUAL(mbedtls_spake2p_write_confirm(&srv, confirmV, sizeof(confirmV),
                                             &clenV),
               MBEDTLS_ERR_ECP_BAD_INPUT_DATA);

    TEST_EQUAL(mbedtls_spake2p_read_key_share(&srv, peer_shareP->x,
                                              peer_shareP->len,
                                              spake2p_kat_rng, &rng_srv), 0);

    TEST_EQUAL(mbedtls_spake2p_write_confirm(&srv, confirmV, sizeof(confirmV),
                                             &clenV), 0);
    TEST_MEMORY_COMPARE(confirmV, clenV, exp_confirmV->x, exp_confirmV->len);

exit:
    mbedtls_spake2p_free(&srv);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_TEST_HOOKS */
void spake2p_prover_read_confirm_kat(int curve_arg, int hash_arg, int mac_arg,
                                     data_t *context, data_t *prover_id,
                                     data_t *verifier_id, data_t *client_key,
                                     data_t *x, data_t *peer_shareV,
                                     data_t *confirmV)
{
    /* Known-answer test for the Prover (client) confirmation check. After the
     * client writes its own share (shareP, from the fixed ephemeral x) and
     * reads the verifier's share (shareV), the key schedule (RFC 9383 Section
     * 3.3-3.4) is fully determined, so confirmV = MAC(K_confirmV, shareP) is a
     * function of the two shares alone. confirmV is the RFC 9383 Appendix C
     * value the prover must accept; a tampered MAC must be rejected. */
    mbedtls_ecp_group_id curve = curve_arg;
    mbedtls_md_type_t hash = hash_arg;
    mbedtls_spake2p_mac_type mac = mac_arg;
    mbedtls_spake2p_context cli;
    unsigned char shareP[MBEDTLS_ECP_MAX_PT_LEN];
    unsigned char *tampered = NULL;
    size_t lenP;
    uint32_t rng_cli = 0x00c0ffeeu;

    mbedtls_spake2p_init(&cli);
    PSA_INIT();

    TEST_EQUAL(mbedtls_spake2p_setup(&cli, MBEDTLS_SPAKE2P_CLIENT, hash, mac,
                                     MBEDTLS_SPAKE2P_KDF_RFC9383,
                                     curve, client_key->x, client_key->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_context(&cli, context->x, context->len), 0);
    /* For the client, set_user is idProver and set_peer is idVerifier. */
    TEST_EQUAL(mbedtls_spake2p_set_user(&cli, prover_id->x,
                                        prover_id->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_peer(&cli, verifier_id->x,
                                        verifier_id->len), 0);

    /* Confirmation cannot be verified until the key schedule is derived, i.e.
     * before both shares have been exchanged. */
    TEST_EQUAL(mbedtls_spake2p_read_confirm(&cli, confirmV->x, confirmV->len),
               MBEDTLS_ERR_ECP_BAD_INPUT_DATA);

    TEST_EQUAL(mbedtls_spake2p_write_key_share_with_ephemeral(
                   &cli, x->x, x->len, shareP, sizeof(shareP), &lenP,
                   spake2p_kat_rng, &rng_cli), 0);

    /* Still incomplete after our own share alone. */
    TEST_EQUAL(mbedtls_spake2p_read_confirm(&cli, confirmV->x, confirmV->len),
               MBEDTLS_ERR_ECP_BAD_INPUT_DATA);

    TEST_EQUAL(mbedtls_spake2p_read_key_share(&cli, peer_shareV->x,
                                              peer_shareV->len,
                                              spake2p_kat_rng, &rng_cli), 0);

    /* The prover accepts the verifier's RFC 9383 confirmV. */
    TEST_EQUAL(mbedtls_spake2p_read_confirm(&cli, confirmV->x, confirmV->len),
               0);

    /* A single flipped byte must be rejected (constant-time compare). */
    TEST_CALLOC(tampered, confirmV->len);
    memcpy(tampered, confirmV->x, confirmV->len);
    tampered[0] ^= 0x01;
    TEST_EQUAL(mbedtls_spake2p_read_confirm(&cli, tampered, confirmV->len),
               MBEDTLS_ERR_ECP_VERIFY_FAILED);

    /* A wrong length is also rejected. */
    TEST_EQUAL(mbedtls_spake2p_read_confirm(&cli, confirmV->x,
                                            confirmV->len - 1),
               MBEDTLS_ERR_ECP_VERIFY_FAILED);

exit:
    mbedtls_free(tampered);
    mbedtls_spake2p_free(&cli);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_TEST_HOOKS */
void spake2p_prover_confirm_kat(int curve_arg, int hash_arg, int mac_arg,
                                data_t *context, data_t *prover_id,
                                data_t *verifier_id, data_t *client_key,
                                data_t *x, data_t *peer_shareV,
                                data_t *exp_confirmP)
{
    /* Known-answer test for the Prover (client) confirmation MAC. After the
     * client writes its own share (shareP, from the fixed ephemeral x) and
     * reads the verifier's share (shareV), the key schedule (RFC 9383 Section
     * 3.3-3.4) is fully determined, so confirmP = MAC(K_confirmP, shareV) is a
     * function of the two shares alone. exp_confirmP is the RFC 9383 Appendix C
     * value. */
    mbedtls_ecp_group_id curve = curve_arg;
    mbedtls_md_type_t hash = hash_arg;
    mbedtls_spake2p_mac_type mac = mac_arg;
    mbedtls_spake2p_context cli;
    unsigned char shareP[MBEDTLS_ECP_MAX_PT_LEN];
    unsigned char confirmP[MBEDTLS_MD_MAX_SIZE];
    size_t lenP, clenP;
    uint32_t rng_cli = 0x00c0ffeeu;

    mbedtls_spake2p_init(&cli);
    PSA_INIT();

    TEST_EQUAL(mbedtls_spake2p_setup(&cli, MBEDTLS_SPAKE2P_CLIENT, hash, mac,
                                     MBEDTLS_SPAKE2P_KDF_RFC9383,
                                     curve, client_key->x, client_key->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_context(&cli, context->x, context->len), 0);
    /* For the client, set_user is idProver and set_peer is idVerifier. */
    TEST_EQUAL(mbedtls_spake2p_set_user(&cli, prover_id->x,
                                        prover_id->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_peer(&cli, verifier_id->x,
                                        verifier_id->len), 0);

    /* Confirmation is not available until the key schedule is derived, i.e.
     * before both shares have been exchanged. */
    TEST_EQUAL(mbedtls_spake2p_write_confirm(&cli, confirmP, sizeof(confirmP),
                                             &clenP),
               MBEDTLS_ERR_ECP_BAD_INPUT_DATA);

    TEST_EQUAL(mbedtls_spake2p_write_key_share_with_ephemeral(
                   &cli, x->x, x->len, shareP, sizeof(shareP), &lenP,
                   spake2p_kat_rng, &rng_cli), 0);

    /* Still incomplete after our own share alone. */
    TEST_EQUAL(mbedtls_spake2p_write_confirm(&cli, confirmP, sizeof(confirmP),
                                             &clenP),
               MBEDTLS_ERR_ECP_BAD_INPUT_DATA);

    TEST_EQUAL(mbedtls_spake2p_read_key_share(&cli, peer_shareV->x,
                                              peer_shareV->len,
                                              spake2p_kat_rng, &rng_cli), 0);

    TEST_EQUAL(mbedtls_spake2p_write_confirm(&cli, confirmP, sizeof(confirmP),
                                             &clenP), 0);
    TEST_MEMORY_COMPARE(confirmP, clenP, exp_confirmP->x, exp_confirmP->len);

exit:
    mbedtls_spake2p_free(&cli);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_TEST_HOOKS */
void spake2p_shared_key_kat(int curve_arg, int hash_arg, int mac_arg,
                            data_t *context, data_t *prover_id,
                            data_t *verifier_id, data_t *client_key,
                            data_t *server_key, data_t *x, data_t *y,
                            data_t *exp_shared)
{
    /* Full client+server handshake to completion (both KEY_SHARE and both
     * CONFIRM exchanges), then export K_shared on both sides. Both shared keys
     * must equal each other and the RFC 9383 Appendix C K_shared value
     * (exp_shared). Also checks the security gate: mbedtls_spake2p_get_shared_key
     * must FAIL before the peer's confirmation MAC has been verified, even
     * though the key schedule (and hence K_shared) is already derived. */
    mbedtls_ecp_group_id curve = curve_arg;
    mbedtls_md_type_t hash = hash_arg;
    mbedtls_spake2p_mac_type mac = mac_arg;
    mbedtls_spake2p_context cli, srv;
    unsigned char shareP[MBEDTLS_ECP_MAX_PT_LEN];
    unsigned char shareV[MBEDTLS_ECP_MAX_PT_LEN];
    unsigned char confirmP[MBEDTLS_MD_MAX_SIZE];
    unsigned char confirmV[MBEDTLS_MD_MAX_SIZE];
    unsigned char shared_cli[MBEDTLS_MD_MAX_SIZE];
    unsigned char shared_srv[MBEDTLS_MD_MAX_SIZE];
    size_t lenP, lenV, clenP, clenV, slen_cli, slen_srv;
    uint32_t rng_cli = 0x00c0ffeeu, rng_srv = 0x0badf00du;

    mbedtls_spake2p_init(&cli);
    mbedtls_spake2p_init(&srv);
    PSA_INIT();

    /* Prover (client): set_user is idProver, set_peer is idVerifier. */
    TEST_EQUAL(mbedtls_spake2p_setup(&cli, MBEDTLS_SPAKE2P_CLIENT, hash, mac,
                                     MBEDTLS_SPAKE2P_KDF_RFC9383,
                                     curve, client_key->x, client_key->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_context(&cli, context->x, context->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_user(&cli, prover_id->x, prover_id->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_peer(&cli, verifier_id->x,
                                        verifier_id->len), 0);
    TEST_EQUAL(mbedtls_spake2p_write_key_share_with_ephemeral(
                   &cli, x->x, x->len, shareP, sizeof(shareP), &lenP,
                   spake2p_kat_rng, &rng_cli), 0);

    /* Verifier (server): set_user is idVerifier, set_peer is idProver. */
    TEST_EQUAL(mbedtls_spake2p_setup(&srv, MBEDTLS_SPAKE2P_SERVER, hash, mac,
                                     MBEDTLS_SPAKE2P_KDF_RFC9383,
                                     curve, server_key->x, server_key->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_context(&srv, context->x, context->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_user(&srv, verifier_id->x,
                                        verifier_id->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_peer(&srv, prover_id->x, prover_id->len), 0);
    TEST_EQUAL(mbedtls_spake2p_write_key_share_with_ephemeral(
                   &srv, y->x, y->len, shareV, sizeof(shareV), &lenV,
                   spake2p_kat_rng, &rng_srv), 0);

    /* Exchange shares: K_shared and the confirmation keys are now derived. */
    TEST_EQUAL(mbedtls_spake2p_read_key_share(&cli, shareV, lenV,
                                              spake2p_kat_rng, &rng_cli), 0);
    TEST_EQUAL(mbedtls_spake2p_read_key_share(&srv, shareP, lenP,
                                              spake2p_kat_rng, &rng_srv), 0);

    /* Produce both confirmation MACs. */
    TEST_EQUAL(mbedtls_spake2p_write_confirm(&cli, confirmP,
                                             sizeof(confirmP), &clenP), 0);
    TEST_EQUAL(mbedtls_spake2p_write_confirm(&srv, confirmV,
                                             sizeof(confirmV), &clenV), 0);

    /* Security negative: K_shared is fully derived here, yet get_shared_key
     * must still refuse because the peer's confirmation MAC has not been
     * verified. This exercises the dedicated `confirmed` flag, not the PSA
     * call-sequence state. */
    TEST_EQUAL(mbedtls_spake2p_get_shared_key(&cli, shared_cli,
                                              sizeof(shared_cli), &slen_cli),
               MBEDTLS_ERR_ECP_BAD_INPUT_DATA);
    TEST_EQUAL(mbedtls_spake2p_get_shared_key(&srv, shared_srv,
                                              sizeof(shared_srv), &slen_srv),
               MBEDTLS_ERR_ECP_BAD_INPUT_DATA);

    /* Verify the peer's confirmation MAC on each side; this sets `confirmed`. */
    TEST_EQUAL(mbedtls_spake2p_read_confirm(&cli, confirmV, clenV), 0);
    TEST_EQUAL(mbedtls_spake2p_read_confirm(&srv, confirmP, clenP), 0);

    /* Both sides may now export K_shared; both equal the RFC 9383 App C value
     * and therefore each other. */
    TEST_EQUAL(mbedtls_spake2p_get_shared_key(&cli, shared_cli,
                                              sizeof(shared_cli), &slen_cli), 0);
    TEST_EQUAL(mbedtls_spake2p_get_shared_key(&srv, shared_srv,
                                              sizeof(shared_srv), &slen_srv), 0);
    TEST_MEMORY_COMPARE(shared_cli, slen_cli, exp_shared->x, exp_shared->len);
    TEST_MEMORY_COMPARE(shared_srv, slen_srv, exp_shared->x, exp_shared->len);

exit:
    mbedtls_spake2p_free(&cli);
    mbedtls_spake2p_free(&srv);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_TEST_HOOKS:PSA_WANT_ALG_SHA_256:PSA_WANT_ALG_HMAC */
void spake2p_matter_kat(data_t *context, data_t *prover_id, data_t *verifier_id,
                        data_t *client_key, data_t *server_key,
                        data_t *x, data_t *y,
                        data_t *exp_shareP, data_t *exp_shareV,
                        data_t *exp_confirmP, data_t *exp_confirmV,
                        data_t *exp_shared)
{
    /* Known-answer test for the Matter / draft-bar-cfrg-spake2plus-02 key
     * schedule (split digest Kae = Ka || Ke, confirmation keys HKDF-expanded
     * from Ka, shared secret = Ke). The ciphersuite is HMAC-SHA-256 / P-256. */
    mbedtls_spake2p_context cli, srv;
    unsigned char shareP[MBEDTLS_ECP_MAX_PT_LEN];
    unsigned char shareV[MBEDTLS_ECP_MAX_PT_LEN];
    unsigned char shared_cli[MBEDTLS_MD_MAX_SIZE];
    unsigned char shared_srv[MBEDTLS_MD_MAX_SIZE];
    unsigned char confirmP[MBEDTLS_MD_MAX_SIZE];
    unsigned char confirmV[MBEDTLS_MD_MAX_SIZE];
    size_t lenP, lenV, slen_cli, slen_srv, clenP, clenV;
    uint32_t rng_cli = 0x00c0ffeeu, rng_srv = 0x0badf00du;

    mbedtls_spake2p_init(&cli);
    mbedtls_spake2p_init(&srv);
    PSA_INIT();

    TEST_EQUAL(mbedtls_spake2p_setup(&cli, MBEDTLS_SPAKE2P_CLIENT,
                                     MBEDTLS_MD_SHA256, MBEDTLS_SPAKE2P_MAC_HMAC,
                                     MBEDTLS_SPAKE2P_KDF_MATTER,
                                     MBEDTLS_ECP_DP_SECP256R1,
                                     client_key->x, client_key->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_context(&cli, context->x, context->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_user(&cli, prover_id->x, prover_id->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_peer(&cli, verifier_id->x,
                                        verifier_id->len), 0);
    TEST_EQUAL(mbedtls_spake2p_write_key_share_with_ephemeral(
                   &cli, x->x, x->len, shareP, sizeof(shareP), &lenP,
                   spake2p_kat_rng, &rng_cli), 0);
    TEST_MEMORY_COMPARE(shareP, lenP, exp_shareP->x, exp_shareP->len);

    TEST_EQUAL(mbedtls_spake2p_setup(&srv, MBEDTLS_SPAKE2P_SERVER,
                                     MBEDTLS_MD_SHA256, MBEDTLS_SPAKE2P_MAC_HMAC,
                                     MBEDTLS_SPAKE2P_KDF_MATTER,
                                     MBEDTLS_ECP_DP_SECP256R1,
                                     server_key->x, server_key->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_context(&srv, context->x, context->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_user(&srv, verifier_id->x,
                                        verifier_id->len), 0);
    TEST_EQUAL(mbedtls_spake2p_set_peer(&srv, prover_id->x, prover_id->len), 0);
    TEST_EQUAL(mbedtls_spake2p_write_key_share_with_ephemeral(
                   &srv, y->x, y->len, shareV, sizeof(shareV), &lenV,
                   spake2p_kat_rng, &rng_srv), 0);
    TEST_MEMORY_COMPARE(shareV, lenV, exp_shareV->x, exp_shareV->len);

    TEST_EQUAL(mbedtls_spake2p_read_key_share(&cli, shareV, lenV,
                                              spake2p_kat_rng, &rng_cli), 0);
    TEST_EQUAL(mbedtls_spake2p_read_key_share(&srv, shareP, lenP,
                                              spake2p_kat_rng, &rng_srv), 0);

    TEST_EQUAL(mbedtls_spake2p_write_confirm(&cli, confirmP,
                                             sizeof(confirmP), &clenP), 0);
    TEST_EQUAL(mbedtls_spake2p_write_confirm(&srv, confirmV,
                                             sizeof(confirmV), &clenV), 0);
    TEST_MEMORY_COMPARE(confirmP, clenP, exp_confirmP->x, exp_confirmP->len);
    TEST_MEMORY_COMPARE(confirmV, clenV, exp_confirmV->x, exp_confirmV->len);

    TEST_EQUAL(mbedtls_spake2p_read_confirm(&cli, confirmV, clenV), 0);
    TEST_EQUAL(mbedtls_spake2p_read_confirm(&srv, confirmP, clenP), 0);

    /* The Matter shared secret is Ke, the second half of Kae (16 bytes). */
    TEST_EQUAL(mbedtls_spake2p_get_shared_key(&cli, shared_cli,
                                              sizeof(shared_cli), &slen_cli), 0);
    TEST_EQUAL(mbedtls_spake2p_get_shared_key(&srv, shared_srv,
                                              sizeof(shared_srv), &slen_srv), 0);
    TEST_MEMORY_COMPARE(shared_cli, slen_cli, exp_shared->x, exp_shared->len);
    TEST_MEMORY_COMPARE(shared_srv, slen_srv, exp_shared->x, exp_shared->len);

exit:
    mbedtls_spake2p_free(&cli);
    mbedtls_spake2p_free(&srv);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_ECP_DP_SECP256R1_ENABLED:PSA_WANT_ALG_SHA_256 */
void spake2p_read_key_share_invalid(data_t *server_key, data_t *bad_share,
                                    int expected_ret)
{
    /* read_key_share must reject a peer share that is not a valid SEC1 point
     * on the curve (parse failure or group-membership failure). */
    mbedtls_spake2p_context srv;
    uint32_t rng_srv = 0x00c0ffeeu;

    mbedtls_spake2p_init(&srv);
    PSA_INIT();

    TEST_EQUAL(mbedtls_spake2p_setup(&srv, MBEDTLS_SPAKE2P_SERVER,
                                     MBEDTLS_MD_SHA256, MBEDTLS_SPAKE2P_MAC_HMAC,
                                     MBEDTLS_SPAKE2P_KDF_RFC9383,
                                     MBEDTLS_ECP_DP_SECP256R1,
                                     server_key->x, server_key->len), 0);
    TEST_EQUAL(mbedtls_spake2p_read_key_share(&srv, bad_share->x,
                                              bad_share->len,
                                              spake2p_kat_rng, &rng_srv),
               expected_ret);

exit:
    mbedtls_spake2p_free(&srv);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_ECP_DP_SECP256R1_ENABLED:PSA_WANT_ALG_SHA_256 */
void spake2p_setup_negative(int curve_arg, int hash_arg, int mac_arg,
                            int kdf_arg, data_t *key, int expected_ret)
{
    /* mbedtls_spake2p_setup() must reject a bad role, an unsupported curve,
     * an unsupported ciphersuite combination (e.g. the Matter key schedule
     * outside P-256/SHA-256), or key material of the wrong length. */
    mbedtls_spake2p_context ctx;

    mbedtls_spake2p_init(&ctx);
    PSA_INIT();

    TEST_EQUAL(mbedtls_spake2p_setup(&ctx, MBEDTLS_SPAKE2P_CLIENT, hash_arg,
                                     mac_arg, kdf_arg,
                                     curve_arg, key->x, key->len),
               expected_ret);

exit:
    mbedtls_spake2p_free(&ctx);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_ECP_DP_SECP256R1_ENABLED:PSA_WANT_ALG_SHA_256 */
void spake2p_setup_negative_server(int curve_arg, int hash_arg, int mac_arg,
                                   data_t *key, int expected_ret)
{
    /* The Verifier setup must reject server key material (w0||L) of the wrong
     * length. */
    mbedtls_spake2p_context ctx;

    mbedtls_spake2p_init(&ctx);
    PSA_INIT();

    TEST_EQUAL(mbedtls_spake2p_setup(&ctx, MBEDTLS_SPAKE2P_SERVER, hash_arg,
                                     mac_arg, MBEDTLS_SPAKE2P_KDF_RFC9383,
                                     curve_arg, key->x, key->len),
               expected_ret);

exit:
    mbedtls_spake2p_free(&ctx);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_ECP_DP_SECP256R1_ENABLED:PSA_WANT_ALG_SHA_256:MBEDTLS_TEST_HOOKS */
void spake2p_prover_share_buffer_too_small(data_t *client_key, data_t *x)
{
    /* An output buffer shorter than the SEC1 share must be rejected, never
     * silently truncated. */
    mbedtls_spake2p_context cli;
    unsigned char shareP[MBEDTLS_ECP_MAX_PT_LEN];
    size_t lenP;
    uint32_t rng_cli = 0x00c0ffeeu;

    mbedtls_spake2p_init(&cli);
    PSA_INIT();

    TEST_EQUAL(mbedtls_spake2p_setup(&cli, MBEDTLS_SPAKE2P_CLIENT,
                                     MBEDTLS_MD_SHA256, MBEDTLS_SPAKE2P_MAC_HMAC,
                                     MBEDTLS_SPAKE2P_KDF_RFC9383,
                                     MBEDTLS_ECP_DP_SECP256R1,
                                     client_key->x, client_key->len), 0);
    /* P-256 share is 65 bytes; 64 must not fit. */
    TEST_ASSERT(mbedtls_spake2p_write_key_share_with_ephemeral(
                    &cli, x->x, x->len, shareP, 64, &lenP,
                    spake2p_kat_rng, &rng_cli) != 0);

exit:
    mbedtls_spake2p_free(&cli);
    PSA_DONE();
}
/* END_CASE */
