static data_t private_key_data(int pkf)
{
    const uint8_t *x = NULL;
    size_t len = 0;
    switch (pkf) {
        case PKF_SEED:
            x = seed_1;
            len = sizeof(seed_1);
            break;
        case PKF_JOINED:
            x = joined_private_key_1;
            len = sizeof(joined_private_key_1);
            break;
        default:
            TEST_FAIL("Unsupported private key format specified");
            break;
    }

exit:;
    data_t data = { .x = (uint8_t *) x, .len = len };
    return data;
}

static psa_status_t poison_setup(int poison_mode, int64_t poison_bytes)
{
    TEST_LE_S(0, poison_bytes);
    TEST_LE_U(poison_mode, POISON_ON_UNLOCK);
    switch (poison_mode) {
        case POISON_ON_LOCK:
            tf_psa_crypto_pqcp_alloc_poison_bytes = poison_bytes;
            break;
        case POISON_ON_UNLOCK:
            tf_psa_crypto_pqcp_alloc_poison_bytes = -poison_bytes;
            tf_psa_crypto_pqcp_alloc_used += poison_bytes;
            break;
        default:
            TEST_EQUAL(poison_bytes, 0);
            break;
    }
    return PSA_SUCCESS;
exit:
    return PSA_ERROR_NOT_SUPPORTED;
}

static void poison_cleanup(void)
{
    tf_psa_crypto_pqcp_alloc_used = 0;
    tf_psa_crypto_pqcp_alloc_poison_bytes = 0;
}

#endif /* defined(TF_PSA_CRYPTO_PQCP_BUFFER_ALLOC) &&
          defined(MBEDTLS_TEST_HOOKS) &&
          defined(TF_PSA_CRYPTO_PQCP_MLDSA_87_ENABLED) */

/* END_HEADER */

/* BEGIN_DEPENDENCIES
 * depends_on:TF_PSA_CRYPTO_PQCP_MLDSA_ENABLED:MBEDTLS_PSA_CRYPTO_C
 * END_DEPENDENCIES */

/* BEGIN_CASE */
void size_macros()
{
    TEST_EQUAL(TF_PSA_CRYPTO_PQCP_MLDSA_SEED_SIZE, MLDSA_SEEDBYTES);

#if defined(TF_PSA_CRYPTO_PQCP_MLDSA_87_ENABLED)
    TEST_EQUAL(TF_PSA_CRYPTO_PQCP_MLDSA_PUBLIC_KEY_SIZE(87),
               MLDSA87_PUBLICKEYBYTES);
    TEST_LE_U(TF_PSA_CRYPTO_PQCP_MLDSA_PUBLIC_KEY_SIZE(87),
              TF_PSA_CRYPTO_PQCP_MLDSA_PUBLIC_KEY_MAX_SIZE);
    TEST_EQUAL(TF_PSA_CRYPTO_PQCP_MLDSA_JOINED_PRIVATE_KEY_SIZE(87),
               MLDSA_SEEDBYTES + MLDSA87_SECRETKEYBYTES);
    TEST_LE_U(TF_PSA_CRYPTO_PQCP_MLDSA_JOINED_PRIVATE_KEY_SIZE(87),
              TF_PSA_CRYPTO_PQCP_MLDSA_JOINED_PRIVATE_KEY_MAX_SIZE);
    TEST_EQUAL(PSA_MLDSA_SIGNATURE_SIZE(87), MLDSA87_BYTES);
#endif
}
/* END_CASE */

/* BEGIN_CASE */
void expand_private_key(int bits,
                        data_t *input, int alias,
                        data_t *expected_output, int delta,
                        psa_status_t expected_status)
{
    uint8_t *input_copy = NULL;
    uint8_t *output = NULL;
    size_t output_size = expected_output->len + delta;
    size_t output_length = SIZE_MAX;

    PSA_INIT();

    if (alias && input->len > output_size) {
        TEST_CALLOC(output, input->len);
    } else {
        TEST_CALLOC(output, output_size);
    }
    if (alias && input->len != 0) {
        memcpy(output, input->x, input->len);
    }

    TEST_CALLOC(input_copy, input->len);
    if (input->len != 0) {
        memcpy(input_copy, input->x, input->len);
    }
    uint8_t *input_pointer = alias ? output : input->x;

    TEST_EQUAL(tf_psa_crypto_mldsa_expand_private_key(
                   bits,
                   input_pointer, input->len,
                   output, output_size, &output_length),
               expected_status);

    if (expected_status == PSA_SUCCESS) {
        TEST_MEMORY_COMPARE(expected_output->x, expected_output->len,
                            output, output_length);
    } else {
        TEST_EQUAL(output_length, 0);
    }

    /* Check that the input is intact (we don't want it to be cleared
     * on error, whether it's aliased to the output or not.) */
    TEST_MEMORY_COMPARE(input_pointer, input->len,
                        input_copy, input->len);

exit:
    mbedtls_free(input_copy);
    mbedtls_free(output);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:TF_PSA_CRYPTO_PQCP_BUFFER_ALLOC:MBEDTLS_TEST_HOOKS:TF_PSA_CRYPTO_PQCP_MLDSA_87_ENABLED */
void poison_expand_private_key(int alias, int delta,
                               int poison_mode, int64_t poison_bytes,
                               psa_status_t expected_status)
{
    data_t private_key = private_key_data(PKF_SEED);
    data_t joined_key = private_key_data(PKF_JOINED);

    PSA_ASSERT(poison_setup(poison_mode, poison_bytes));
    test_expand_private_key(87, &private_key, alias,
                            &joined_key, delta, expected_status);

exit:
    poison_cleanup();
}
/* END_CASE */

/* BEGIN_CASE */
void export_public_key(int type_arg, int bits_arg,
                       data_t *private_key,
                       data_t *expected_public_key,
                       psa_status_t expected_status)
{
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
    uint8_t *public_key = NULL;

    PSA_INIT();

    psa_set_key_type(&attributes, type_arg);
    psa_set_key_bits(&attributes, bits_arg);

    /* Export into an exact-size buffer */
    size_t public_key_size = expected_public_key->len;
    TEST_CALLOC(public_key, public_key_size);
    size_t public_key_length = SIZE_MAX;
    TEST_EQUAL(tf_psa_crypto_mldsa_export_public_key(&attributes,
                                                     private_key->x, private_key->len,
                                                     public_key,
                                                     public_key_size,
                                                     &public_key_length),
               expected_status);
    if (expected_status == PSA_SUCCESS) {
        TEST_MEMORY_COMPARE(public_key, public_key_length,
                            expected_public_key->x, expected_public_key->len);
    } else {
        /* Check that the reported length is non-risky even on failure */
        TEST_LE_U(public_key_length, public_key_size);
    }
    mbedtls_free(public_key);
    public_key = NULL;

    /* Export into a larger buffer */
    public_key_size = expected_public_key->len + 1;
    TEST_CALLOC(public_key, public_key_size);
    public_key_length = SIZE_MAX;
    TEST_EQUAL(tf_psa_crypto_mldsa_export_public_key(&attributes,
                                                     private_key->x, private_key->len,
                                                     public_key,
                                                     public_key_size,
                                                     &public_key_length),
               expected_status);
    if (expected_status == PSA_SUCCESS) {
        TEST_MEMORY_COMPARE(public_key, public_key_length,
                            expected_public_key->x, expected_public_key->len);
    } else {
        /* Check that the reported length is non-risky even on failure */
        TEST_LE_U(public_key_length, public_key_size);
    }
    mbedtls_free(public_key);
    public_key = NULL;

    /* Try exporting into a buffer that's too small */
    if (expected_status == PSA_SUCCESS) {
        public_key_size = expected_public_key->len - 1;
        TEST_CALLOC(public_key, public_key_size);
        public_key_length = SIZE_MAX;
        TEST_EQUAL(tf_psa_crypto_mldsa_export_public_key(&attributes,
                                                         private_key->x, private_key->len,
                                                         public_key,
                                                         public_key_size,
                                                         &public_key_length),
                   PSA_ERROR_BUFFER_TOO_SMALL);
        /* Check that the reported length is non-risky even on failure */
        TEST_LE_U(public_key_length, public_key_size);
        mbedtls_free(public_key);
        public_key = NULL;
    }

exit:
    mbedtls_free(public_key);
    psa_reset_key_attributes(&attributes);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:TF_PSA_CRYPTO_PQCP_BUFFER_ALLOC:MBEDTLS_TEST_HOOKS:TF_PSA_CRYPTO_PQCP_MLDSA_87_ENABLED */
void poison_export_public_key(int pkf,
                              int poison_mode, int64_t poison_bytes,
                              psa_status_t expected_status)
{
    data_t private_key = private_key_data(pkf);
    data_t public_key = { (uint8_t *) public_key_1, sizeof(public_key_1) };

    PSA_ASSERT(poison_setup(poison_mode, poison_bytes));
    test_export_public_key(PSA_KEY_TYPE_ML_DSA_KEY_PAIR, 87,
                           &private_key, &public_key, expected_status);
exit:
    poison_cleanup();
}
/* END_CASE */

/* BEGIN_CASE */
void generate_key(int type, int bits, int output_size_arg,
                  psa_status_t expected_status)
{
    size_t output_size = output_size_arg;
    size_t output_length = SIZE_MAX;
    uint8_t *output = NULL;
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;

    PSA_INIT();
    TEST_CALLOC(output, output_size);

    psa_set_key_type(&attributes, type);
    psa_set_key_bits(&attributes, bits);
    psa_status_t status = tf_psa_crypto_mldsa_generate_key(&attributes,
                                                           output, output_size,
                                                           &output_length);

    if (expected_status == PSA_SUCCESS) {
        TEST_EQUAL(PSA_SUCCESS, expected_status);
        TEST_EQUAL(output_length, 32);
    } else {
        TEST_EQUAL(status, expected_status);
        TEST_EQUAL(output_length, 0);
    }

exit:
    mbedtls_free(output);
    PSA_DONE();
}
/* END_CASE */

/* No poison_generate_key because we know that
 * tf_psa_crypto_mldsa_generate_key() doesn't call any mldsa-native function
 * or otherwise use the global buffer. */

/* BEGIN_CASE */
void sign_deterministic_pure(int type_arg, int bits_arg, int alg_arg,
                             data_t *private_key,
                             data_t *message,
                             data_t *expected_signature,
                             psa_status_t expected_status)
{
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
    uint8_t *signature = NULL;

    PSA_INIT();

    psa_set_key_type(&attributes, type_arg);
    psa_set_key_bits(&attributes, bits_arg);

    /* Sign into an exact-size buffer */
    size_t signature_size = expected_signature->len;
    TEST_CALLOC(signature, signature_size);
    size_t signature_length = SIZE_MAX;
    TEST_EQUAL(tf_psa_crypto_mldsa_sign_message(&attributes,
                                                private_key->x, private_key->len,
                                                alg_arg,
                                                message->x, message->len,
                                                signature, signature_size,
                                                &signature_length),
               expected_status);
    if (expected_status == PSA_SUCCESS) {
        TEST_MEMORY_COMPARE(signature, signature_length,
                            expected_signature->x, expected_signature->len);
    } else {
        /* Check that the reported length is non-risky even on failure */
        TEST_LE_U(signature_length, signature_size);
    }
    mbedtls_free(signature);
    signature = NULL;

    /* Sign into a larger buffer */
    signature_size = expected_signature->len + 1;
    TEST_CALLOC(signature, signature_size);
    signature_length = SIZE_MAX;
    TEST_EQUAL(tf_psa_crypto_mldsa_sign_message(&attributes,
                                                private_key->x, private_key->len,
                                                alg_arg,
                                                message->x, message->len,
                                                signature, signature_size,
                                                &signature_length),
               expected_status);
    if (expected_status == PSA_SUCCESS) {
        TEST_MEMORY_COMPARE(signature, signature_length,
                            expected_signature->x, expected_signature->len);
    } else {
        /* Check that the reported length is non-risky even on failure */
        TEST_LE_U(signature_length, signature_size);
    }
    mbedtls_free(signature);
    signature = NULL;

    if (expected_status == PSA_SUCCESS) {
        signature_size = expected_signature->len - 1;
        TEST_CALLOC(signature, signature_size);
        signature_length = SIZE_MAX;
        TEST_EQUAL(tf_psa_crypto_mldsa_sign_message(&attributes,
                                                    private_key->x, private_key->len,
                                                    alg_arg,
                                                    message->x, message->len,
                                                    signature, signature_size,
                                                    &signature_length),
                   PSA_ERROR_BUFFER_TOO_SMALL);
        /* Check that the reported length is non-risky even on failure */
        TEST_LE_U(signature_length, signature_size);
        mbedtls_free(signature);
        signature = NULL;
    }

exit:
    mbedtls_free(signature);
    psa_reset_key_attributes(&attributes);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:TF_PSA_CRYPTO_PQCP_BUFFER_ALLOC:MBEDTLS_TEST_HOOKS:TF_PSA_CRYPTO_PQCP_MLDSA_87_ENABLED */
void poison_sign_deterministic_pure(int pkf,
                                    int poison_mode, int64_t poison_bytes,
                                    psa_status_t expected_status)
{
    data_t private_key = private_key_data(pkf);
    data_t message = { (uint8_t *) message_1, sizeof(message_1) };
    data_t expected_signature = { (uint8_t *) signature_1, sizeof(signature_1) };

    PSA_ASSERT(poison_setup(poison_mode, poison_bytes));
    test_sign_deterministic_pure(PSA_KEY_TYPE_ML_DSA_KEY_PAIR, 87, PSA_ALG_DETERMINISTIC_ML_DSA,
                                 &private_key, &message, &expected_signature, expected_status);
exit:
    poison_cleanup();
}
/* END_CASE */

/* BEGIN_CASE */
void verify_pure(int type_arg, int bits_arg, int alg_arg,
                 data_t *public_key,
                 data_t *message,
                 data_t *signature,
                 psa_status_t expected_status)
{
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
    uint8_t *buf = NULL;

    PSA_INIT();

    psa_set_key_type(&attributes, type_arg);
    psa_set_key_bits(&attributes, bits_arg);

    TEST_EQUAL(tf_psa_crypto_mldsa_verify_message(&attributes,
                                                  public_key->x, public_key->len,
                                                  alg_arg,
                                                  message->x, message->len,
                                                  signature->x, signature->len),
               expected_status);

    if (expected_status == PSA_SUCCESS) {
        /* Try verifying a signature whose last byte is wrong */
        TEST_CALLOC(buf, signature->len);
        memcpy(buf, signature->x, signature->len);
        buf[signature->len - 1] ^= 1;
        TEST_EQUAL(tf_psa_crypto_mldsa_verify_message(
                       &attributes,
                       public_key->x, public_key->len,
                       alg_arg,
                       message->x, message->len,
                       buf, signature->len),
                   PSA_ERROR_INVALID_SIGNATURE);
        mbedtls_free(buf);
        buf  = NULL;

        /* Try verifying a signature that's too short */
        TEST_CALLOC(buf, signature->len - 1);
        memcpy(buf, signature->x, signature->len - 1);
        TEST_EQUAL(tf_psa_crypto_mldsa_verify_message(
                       &attributes,
                       public_key->x, public_key->len,
                       alg_arg,
                       message->x, message->len,
                       buf, signature->len - 1),
                   PSA_ERROR_INVALID_SIGNATURE);
        mbedtls_free(buf);
        buf  = NULL;

        /* Try verifying a signature that's too long */
        TEST_CALLOC(buf, signature->len + 1);
        memcpy(buf, signature->x, signature->len);
        TEST_EQUAL(tf_psa_crypto_mldsa_verify_message(
                       &attributes,
                       public_key->x, public_key->len,
                       alg_arg,
                       message->x, message->len,
                       buf, signature->len + 1),
                   PSA_ERROR_INVALID_SIGNATURE);
        mbedtls_free(buf);
        buf = NULL;
    }

exit:
    PSA_DONE();
    mbedtls_free(buf);
}
/* END_CASE */

/* BEGIN_CASE depends_on:TF_PSA_CRYPTO_PQCP_BUFFER_ALLOC:MBEDTLS_TEST_HOOKS:TF_PSA_CRYPTO_PQCP_MLDSA_87_ENABLED */
void poison_verify_pure(int poison_mode, int64_t poison_bytes,
                        psa_status_t expected_status)
{
    data_t message = { (uint8_t *) message_1, sizeof(message_1) };
    data_t public_key = { (uint8_t *) public_key_1, sizeof(public_key_1) };
    data_t signature = { (uint8_t *) signature_1, sizeof(signature_1) };

    PSA_ASSERT(poison_setup(poison_mode, poison_bytes));

    mbedtls_test_set_step(1);
    test_verify_pure(PSA_KEY_TYPE_ML_DSA_PUBLIC_KEY, 87, PSA_ALG_DETERMINISTIC_ML_DSA,
                     &public_key, &message, &signature, expected_status);

    mbedtls_test_set_step(2);
    public_key.len -= 1;
    test_verify_pure(PSA_KEY_TYPE_ML_DSA_PUBLIC_KEY, 87, PSA_ALG_DETERMINISTIC_ML_DSA,
                     &public_key, &message, &signature, PSA_ERROR_INVALID_ARGUMENT);

exit:
    poison_cleanup();
}
/* END_CASE */

/* BEGIN_CASE */
void sign_setup(int type_arg, int bits_arg, int alg_arg,
                data_t *private_key,
                psa_status_t expected_status)
{
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
    tf_psa_crypto_mldsa_operation_t operation;
    memset(&operation, 0, sizeof(operation));

    PSA_INIT();

    psa_set_key_type(&attributes, type_arg);
    psa_set_key_bits(&attributes, bits_arg);

    TEST_EQUAL(tf_psa_crypto_mldsa_sign_setup(&operation,
                                              &attributes,
                                              private_key->x, private_key->len,
                                              alg_arg),
               expected_status);

    PSA_ASSERT(tf_psa_crypto_mldsa_abort(&operation));

exit:
    tf_psa_crypto_mldsa_abort(&operation);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:TF_PSA_CRYPTO_PQCP_BUFFER_ALLOC:MBEDTLS_TEST_HOOKS:TF_PSA_CRYPTO_PQCP_MLDSA_87_ENABLED */
void poison_sign_setup(int pkf,
                       int poison_mode, int64_t poison_bytes,
                       psa_status_t expected_status)
{
