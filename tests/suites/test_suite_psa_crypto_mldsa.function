/* BEGIN_HEADER */

/* Test the MLDSA driver.
 * We generally assume that the underlying implementation is functionally
 * correct. The main objective of this test suite is to cover parameter
 * validation.
 */

#include <psa_crypto_mldsa.h>

/* END_HEADER */

/* BEGIN_DEPENDENCIES
 * depends_on:TF_PSA_CRYPTO_PQCP_MLDSA_ENABLED
 * END_DEPENDENCIES */

/* BEGIN_CASE */
void export_public_key(int type_arg, int bits_arg,
                       data_t *seed,
                       data_t *expected_public_key,
                       psa_status_t expected_status)
{
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
    uint8_t *public_key = NULL;
    size_t public_key_size = expected_public_key->len;
    size_t public_key_length = SIZE_MAX;

    PSA_INIT();

    psa_set_key_type(&attributes, type_arg);
    psa_set_key_bits(&attributes, bits_arg);

    TEST_CALLOC(public_key, public_key_size);
    TEST_EQUAL(tf_psa_crypto_mldsa_export_public_key(&attributes,
                                                     seed->x, seed->len,
                                                     public_key,
                                                     public_key_size,
                                                     &public_key_length),
               expected_status);
    TEST_LE_U(public_key_length, public_key_size);

    if (expected_status == PSA_SUCCESS) {
        mbedtls_free(public_key);
        public_key = NULL;

        public_key_size = expected_public_key->len - 1;
        TEST_CALLOC(public_key, public_key_size);
        TEST_EQUAL(tf_psa_crypto_mldsa_export_public_key(&attributes,
                                                         seed->x, seed->len,
                                                         public_key,
                                                         public_key_size,
                                                         &public_key_length),
                   PSA_ERROR_BUFFER_TOO_SMALL);
        TEST_LE_U(public_key_length, public_key_size);
    }

exit:
    mbedtls_free(public_key);
    psa_reset_key_attributes(&attributes);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE */
/* Good and bad cases for one-shot determinisitic signature, and for
 * the setup phase of multipart deterministic signature. */
void sign_deterministic_pure(int type_arg, int bits_arg, int alg_arg,
                             data_t *seed,
                             data_t *message,
                             data_t *expected_signature,
                             psa_status_t expected_status)
{
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
    uint8_t *signature = NULL;
    size_t signature_size = expected_signature->len;
    size_t signature_length = SIZE_MAX;
#if defined(TF_PSA_CRYPTO_PQCP_MLDSA_MULTIPART)
    tf_psa_crypto_mldsa_sign_operation_t operation =
        TF_PSA_CRYPTO_MLDSA_SIGN_OPERATION_INIT;
#endif

    PSA_INIT();

    psa_set_key_type(&attributes, type_arg);
    psa_set_key_bits(&attributes, bits_arg);

    TEST_CALLOC(signature, signature_size);
    TEST_EQUAL(tf_psa_crypto_mldsa_sign_message(&attributes,
                                                seed->x, seed->len,
                                                alg_arg,
                                                message->x, message->len,
                                                signature, signature_size,
                                                &signature_length),
               expected_status);
    TEST_LE_U(signature_length, signature_size);

#if defined(TF_PSA_CRYPTO_PQCP_MLDSA_MULTIPART)
    if (expected_status != PSA_ERROR_BUFFER_TOO_SMALL) {
        TEST_EQUAL(tf_psa_crypto_mldsa_sign_setup(
                       &operation,
                       &attributes, seed->x, seed->len,
                       alg_arg),
                   expected_status);
        PSA_ASSERT(tf_psa_crypto_mldsa_sign_abort(&operation));
    }
#endif

    if (expected_status == PSA_SUCCESS) {
        TEST_MEMORY_COMPARE(signature, signature_length,
                            expected_signature->x, expected_signature->len);

        mbedtls_free(signature);
        signature = NULL;

        signature_size = expected_signature->len - 1;
        TEST_CALLOC(signature, signature_size);
        TEST_EQUAL(tf_psa_crypto_mldsa_sign_message(&attributes,
                                                    seed->x, seed->len,
                                                    alg_arg,
                                                    message->x, message->len,
                                                    signature, signature_size,
                                                    &signature_length),
                   PSA_ERROR_BUFFER_TOO_SMALL);
        TEST_LE_U(signature_length, signature_size);
    }

exit:
#if defined(TF_PSA_CRYPTO_PQCP_MLDSA_MULTIPART)
    tf_psa_crypto_mldsa_sign_abort(&operation);
#endif
    mbedtls_free(signature);
    psa_reset_key_attributes(&attributes);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE */
/* Good and bad cases for one-shot verification, and for
 * the setup phase of multipart verification. */
void verify_pure(int type_arg, int bits_arg, int alg_arg,
                 data_t *public_key,
                 data_t *message,
                 data_t *signature,
                 psa_status_t expected_status)
{
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
    uint8_t *buf = NULL;
#if defined(TF_PSA_CRYPTO_PQCP_MLDSA_MULTIPART)
    tf_psa_crypto_mldsa_verify_operation_t operation =
        TF_PSA_CRYPTO_MLDSA_VERIFY_OPERATION_INIT;
#endif

    PSA_INIT();

    psa_set_key_type(&attributes, type_arg);
    psa_set_key_bits(&attributes, bits_arg);

    TEST_EQUAL(tf_psa_crypto_mldsa_verify_message(&attributes,
                                                  public_key->x, public_key->len,
                                                  alg_arg,
                                                  message->x, message->len,
                                                  signature->x, signature->len),
               expected_status);

#if defined(TF_PSA_CRYPTO_PQCP_MLDSA_MULTIPART)
    if (expected_status != PSA_ERROR_INVALID_SIGNATURE) {
        TEST_EQUAL(tf_psa_crypto_mldsa_verify_setup(
                       &operation,
                       &attributes, public_key->x, public_key->len,
                       alg_arg),
                   expected_status);
        PSA_ASSERT(tf_psa_crypto_mldsa_verify_abort(&operation));
    }
#endif

    if (expected_status != PSA_SUCCESS) {
        goto exit;
    }

    /* Try verifying a signature whose last byte is wrong */
    signature->x[signature->len - 1] ^= 1;
    TEST_EQUAL(tf_psa_crypto_mldsa_verify_message(
                   &attributes,
                   public_key->x, public_key->len,
                   alg_arg,
                   message->x, message->len,
                   signature->x, signature->len),
               PSA_ERROR_INVALID_SIGNATURE);
    signature->x[signature->len - 1] ^= 1;

    /* Try verifying a signature that's too short */
    TEST_CALLOC(buf, signature->len - 1);
    memcpy(buf, signature->x, signature->len - 1);
    TEST_EQUAL(tf_psa_crypto_mldsa_verify_message(
                   &attributes,
                   public_key->x, public_key->len,
                   alg_arg,
                   message->x, message->len,
                   signature->x, signature->len - 1),
               PSA_ERROR_INVALID_SIGNATURE);
    mbedtls_free(buf);
    buf  = NULL;

    /* Try verifying a signature that's too long */
    TEST_CALLOC(buf, signature->len + 1);
    memcpy(buf, signature->x, signature->len);
    TEST_EQUAL(tf_psa_crypto_mldsa_verify_message(
                   &attributes,
                   public_key->x, public_key->len,
                   alg_arg,
                   message->x, message->len,
                   signature->x, signature->len + 1),
               PSA_ERROR_INVALID_SIGNATURE);
    mbedtls_free(buf);
    buf = NULL;

exit:
#if defined(TF_PSA_CRYPTO_PQCP_MLDSA_MULTIPART)
    tf_psa_crypto_mldsa_verify_abort(&operation);
#endif
    PSA_DONE();
    mbedtls_free(buf);
}
/* END_CASE */

/* BEGIN_CASE depends_on:TF_PSA_CRYPTO_PQCP_MLDSA_MULTIPART */
/* Multipart deterministic signature, covering only good cases for setup(),
 * but good and bad cases for finish(). */
void sign_deterministic_pure_multipart(int type_arg, int bits_arg, int alg_arg,
                                       data_t *seed,
                                       data_t *message)
{
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
    tf_psa_crypto_mldsa_sign_operation_t operation =
        TF_PSA_CRYPTO_MLDSA_VERIFY_OPERATION_INIT;
    uint8_t *good_signature = NULL;
    size_t good_signature_size = 4627; /* MLDSA87_BYTES */
    size_t good_signature_length = SIZE_MAX;
    uint8_t *actual_signature = NULL;

    PSA_INIT();

    psa_set_key_type(&attributes, type_arg);
    psa_set_key_bits(&attributes, bits_arg);

    TEST_CALLOC(good_signature, good_signature_size);

    /* Run one-shot verification to obtain the expected signature */
    PSA_ASSERT(tf_psa_crypto_mldsa_sign_message(&attributes,
                                                seed->x, seed->len,
                                                alg_arg,
                                                message->x, message->len,
                                                good_signature, good_signature_size,
                                                &good_signature_length));


    size_t actual_signature_size = good_signature_length;
    TEST_CALLOC(actual_signature, actual_signature_size);
    size_t actual_signature_length = SIZE_MAX;

    /* Run multipart signature with a single update */
    PSA_ASSERT(tf_psa_crypto_mldsa_sign_setup(
                   &operation,
                   &attributes, seed->x, seed->len,
                   alg_arg));
    PSA_ASSERT(tf_psa_crypto_mldsa_sign_update(
                   &operation, message->x, message->len));
    PSA_ASSERT(tf_psa_crypto_mldsa_sign_finish(
                   &operation, actual_signature, actual_signature_size,
                   &actual_signature_length));
    TEST_LE_U(actual_signature_length, actual_signature_size);
    TEST_MEMORY_COMPARE(actual_signature, actual_signature_length,
                        good_signature, good_signature_length);
    PSA_ASSERT(tf_psa_crypto_mldsa_sign_abort(&operation));

    /* Run multipart verification with two updates */
    for (size_t n1 = 0; n1 <= message->len; n1++) {
        size_t n2 = message->len - n1;
        /* This loop is somewhat repetitive and slow. Skip steps with
         * strictly more than one SHAKE256 block in both chunks. */
        if (n1 > 136 && n2 > 136) {
            continue;
        }
        mbedtls_test_set_step(n1);
        PSA_ASSERT(tf_psa_crypto_mldsa_sign_setup(
                       &operation,
                       &attributes, seed->x, seed->len,
                       alg_arg));
        PSA_ASSERT(tf_psa_crypto_mldsa_sign_update(
                       &operation, message->x, n1));
        PSA_ASSERT(tf_psa_crypto_mldsa_sign_update(
                       &operation, message->x + n1, n2));
        PSA_ASSERT(tf_psa_crypto_mldsa_sign_finish(
                       &operation, actual_signature, actual_signature_size,
                       &actual_signature_length));
        TEST_LE_U(actual_signature_length, actual_signature_size);
        TEST_MEMORY_COMPARE(actual_signature, actual_signature_length,
                            good_signature, good_signature_length);
    }

    /* Try an output buffer that's too short */
    mbedtls_free(actual_signature);
    actual_signature = NULL;
    actual_signature_size = good_signature_length - 1;
    TEST_CALLOC(actual_signature, actual_signature_size);
    actual_signature_length = SIZE_MAX;
    PSA_ASSERT(tf_psa_crypto_mldsa_sign_setup(
                   &operation,
                   &attributes, seed->x, seed->len,
                   alg_arg));
    PSA_ASSERT(tf_psa_crypto_mldsa_sign_update(
                   &operation, message->x, message->len));
    TEST_EQUAL(tf_psa_crypto_mldsa_sign_finish(
                   &operation, actual_signature, actual_signature_size,
                   &actual_signature_length),
               PSA_ERROR_BUFFER_TOO_SMALL);
    TEST_LE_U(actual_signature_length, actual_signature_size);

    /* Try an output buffer that's longer than necessary */
    mbedtls_free(actual_signature);
    actual_signature = NULL;
    actual_signature_size = good_signature_length + 1;
    TEST_CALLOC(actual_signature, actual_signature_size);
    actual_signature_length = SIZE_MAX;
    PSA_ASSERT(tf_psa_crypto_mldsa_sign_setup(
                   &operation,
                   &attributes, seed->x, seed->len,
                   alg_arg));
    PSA_ASSERT(tf_psa_crypto_mldsa_sign_update(
                   &operation, message->x, message->len));
    PSA_ASSERT(tf_psa_crypto_mldsa_sign_finish(
                   &operation, actual_signature, actual_signature_size,
                   &actual_signature_length));
    TEST_LE_U(actual_signature_length, actual_signature_size);
    TEST_MEMORY_COMPARE(actual_signature, actual_signature_length,
                        good_signature, good_signature_length);

exit:
    mbedtls_free(good_signature);
    mbedtls_free(actual_signature);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:TF_PSA_CRYPTO_PQCP_MLDSA_MULTIPART */
/* Multipart verification, covering only good cases for setup(),
 * but good and bad cases for finish(). */
void verify_pure_multipart(int type_arg, int bits_arg, int alg_arg,
                           data_t *public_key,
                           data_t *message,
                           data_t *signature)
{
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
    tf_psa_crypto_mldsa_verify_operation_t operation =
        TF_PSA_CRYPTO_MLDSA_VERIFY_OPERATION_INIT;
    uint8_t *buf = NULL;

    PSA_INIT();

    psa_set_key_type(&attributes, type_arg);
    psa_set_key_bits(&attributes, bits_arg);

    /* Run one-shot verification to determine the expected status */
    psa_status_t expected_finish_status =
        tf_psa_crypto_mldsa_verify_message(&attributes,
                                           public_key->x, public_key->len,
                                           alg_arg,
                                           message->x, message->len,
                                           signature->x, signature->len);
    /* This function only covers cases where setup() should succeed.
     * It does cover cases where finish() may fail, namely, an invalid
     * signature. */
    if (expected_finish_status != PSA_SUCCESS) {
        TEST_EQUAL(expected_finish_status, PSA_ERROR_INVALID_SIGNATURE);
    }

    /* Run multipart verification with a single update */
    PSA_ASSERT(tf_psa_crypto_mldsa_verify_setup(
                   &operation,
                   &attributes, public_key->x, public_key->len,
                   alg_arg));
    PSA_ASSERT(tf_psa_crypto_mldsa_verify_update(
                   &operation, message->x, message->len));
    TEST_EQUAL(tf_psa_crypto_mldsa_verify_finish(
                   &operation, signature->x, signature->len),
               expected_finish_status);
    PSA_ASSERT(tf_psa_crypto_mldsa_verify_abort(&operation));

    /* Run multipart verification with two updates */
    for (size_t n1 = 0; n1 <= message->len; n1++) {
        size_t n2 = message->len - n1;
        /* This loop is somewhat repetitive and slow. Skip steps with
         * strictly more than one SHAKE256 block in both chunks. */
        if (n1 > 136 && n2 > 136) {
            continue;
        }
        mbedtls_test_set_step(n1);
        PSA_ASSERT(tf_psa_crypto_mldsa_verify_setup(
                       &operation,
                       &attributes, public_key->x, public_key->len,
                       alg_arg));
        PSA_ASSERT(tf_psa_crypto_mldsa_verify_update(
                       &operation, message->x, n1));
        PSA_ASSERT(tf_psa_crypto_mldsa_verify_update(
                       &operation, message->x + n1, n2));
        PSA_ASSERT(tf_psa_crypto_mldsa_verify_finish(
                       &operation, signature->x, signature->len));
    }

    if (expected_finish_status != PSA_SUCCESS) {
        /* All the remaining checks only provide useful test coverage
         * when they're based on a valid signature. */
        goto exit;
    }

    /* Try verifying a signature whose last byte is wrong */
    signature->x[signature->len - 1] ^= 1;
    PSA_ASSERT(tf_psa_crypto_mldsa_verify_setup(
                   &operation,
                   &attributes, public_key->x, public_key->len,
                   alg_arg));
    PSA_ASSERT(tf_psa_crypto_mldsa_verify_update(
                   &operation, message->x, message->len));
    TEST_EQUAL(tf_psa_crypto_mldsa_verify_finish(
                   &operation, signature->x, signature->len),
               PSA_ERROR_INVALID_SIGNATURE);
    signature->x[signature->len - 1] ^= 1;

    /* Try verifying a signature that's too short */
    TEST_CALLOC(buf, signature->len - 1);
    memcpy(buf, signature->x, signature->len - 1);
    PSA_ASSERT(tf_psa_crypto_mldsa_verify_setup(
                   &operation,
                   &attributes, public_key->x, public_key->len,
                   alg_arg));
    PSA_ASSERT(tf_psa_crypto_mldsa_verify_update(
                   &operation, message->x, message->len));
    TEST_EQUAL(tf_psa_crypto_mldsa_verify_finish(
                   &operation, signature->x, signature->len - 1),
               PSA_ERROR_INVALID_SIGNATURE);
    mbedtls_free(buf);
    buf  = NULL;

    /* Try verifying a signature that's too long */
    TEST_CALLOC(buf, signature->len + 1);
    memcpy(buf, signature->x, signature->len);
    PSA_ASSERT(tf_psa_crypto_mldsa_verify_setup(
                   &operation,
                   &attributes, public_key->x, public_key->len,
                   alg_arg));
    PSA_ASSERT(tf_psa_crypto_mldsa_verify_update(
                   &operation, message->x, message->len));
    TEST_EQUAL(tf_psa_crypto_mldsa_verify_finish(
                   &operation, signature->x, signature->len + 1),
               PSA_ERROR_INVALID_SIGNATURE);
    mbedtls_free(buf);
    buf = NULL;

exit:
    PSA_DONE();
}
/* END_CASE */
