/* BEGIN_HEADER */

/* Test the dispatch layer, a.k.a. driver wrappers, with transparent keys
 * and keyless algorithms.
 *
 * Coverage is extremely sparse for now. See
 * https://github.com/Mbed-TLS/TF-PSA-Crypto/issues/699
 */

#include <psa/crypto.h>
#include <psa_crypto_driver_wrappers.h>
#include <psa_crypto_driver_wrappers_no_static.h>

/* While ML-DSA is only supported in the lower layers but not in the API,
 * include the internal header with the encoding of key types and algorithms.
 * This header is not yet included unconditionally by the driver wrapper
 * headers, but we need all constants that appear in test data to be
 * defined unconditionally. */
#include "psa_crypto_mldsa.h"

#if defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_GENERATE)
static int check_rsa_public_exponent(
    const uint8_t *expected_e, size_t expected_e_length,
    const uint8_t *public, size_t public_length)
{
    const uint8_t default_e[3] = { 0x01, 0x00, 0x01 };
    int ok = 0;

    if (expected_e_length == 0) {
        expected_e = default_e;
        expected_e_length = sizeof(default_e);
    }
    /* For simplicity, we don't support values of e that might need a multi-byte
     * length encoding in ASN.1 (more than 0x7f digits in base 256, or exactly
     * 0x7f where the most significant bit is 1). */
    TEST_LE_U(expected_e_length, 0x7e);
    /* Strip leading zeros */
    while (expected_e_length > 0 && expected_e[0] == 0) {
        ++expected_e;
        --expected_e_length;
    }

    /* We assume that the public key has the expected ASN.1 DER format
     * described in PKCS#1 (RFC 8017 §A.1.1).
     * We only test the value of the public exponent, which is an INTEGER,
     * the last element of the SEQUENCE.
     * We also check that the public exponent has the expected ASN.1
     * type, length, and possible leading zero.
     */
    TEST_LE_U(3 + expected_e_length, public_length);
    const uint8_t *e_start = public + public_length - expected_e_length;
    TEST_MEMORY_COMPARE(e_start, expected_e_length,
                        expected_e, expected_e_length);
    if (expected_e[0] >= 0x80) {
        --e_start;
        ++expected_e_length;
        TEST_EQUAL(e_start[0], 0);
    }
    TEST_EQUAL(e_start[-1], expected_e_length);
    TEST_EQUAL(e_start[-2], 0x02);

    ok = 1;

exit:
    return ok;
}
#endif

/* END_HEADER */

/* BEGIN_DEPENDENCIES
 * depends_on:MBEDTLS_PSA_CRYPTO_C
 * END_DEPENDENCIES */

/* BEGIN_CASE */
/* Generate a key. We can't fully validate the randomness, but at least do
 * some sanity checks.
 *
 * One thing we check is the size of the key representation. The check is based
 * on PSA_EXPORT_KEY_OUTPUT_SIZE(). For key types where this is exact, pass
 * `allow_shorter=0`. For key types where this is an approximation, or
 * where the representation size is variable, the key representation may be
 * anywhere between `PSA_EXPORT_KEY_OUTPUT_SIZE(type, bits) - allow_shorter`
 * and `PSA_EXPORT_KEY_OUTPUT_SIZE(type, bits)` inclusive.
 */
void generate_key(int type, int bits,
                  int custom_flags_arg, data_t *custom_data,
                  int allow_shorter)
{
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
    psa_custom_key_parameters_t custom = PSA_CUSTOM_KEY_PARAMETERS_INIT;
    custom.flags = custom_flags_arg;
    size_t output_size = PSA_EXPORT_KEY_OUTPUT_SIZE(type, bits);
    size_t output_length1 = SIZE_MAX;
    size_t output_length2 = SIZE_MAX;
    uint8_t *output1 = NULL;
    uint8_t *output2 = NULL;
    uint8_t *zero = NULL;
    uint8_t *public = NULL;

#if defined(TF_PSA_CRYPTO_PQCP_MLDSA_ENABLED)
    /* Hack alert: at the time of writing, PSA_EXPORT_KEY_OUTPUT_SIZE
     * doesn't support ML-DSA yet. It returns the size of a symmetric
     * key of the size given by `bits` (e.g. 11 for bits=87).
     * Same for the public key below.
     */
    if (type == PSA_KEY_TYPE_ML_DSA_KEY_PAIR) {
        if (output_size >= TF_PSA_CRYPTO_PQCP_MLDSA_SEED_SIZE) {
            TEST_FAIL("Now that PSA_EXPORT_KEY_OUTPUT_SIZE() supports ML-DSA, remove this hack.");
        }
        if (custom_flags_arg & PSA_CUSTOM_KEY_FLAG_EXPAND) {
            output_size = TF_PSA_CRYPTO_PQCP_MLDSA_JOINED_PRIVATE_KEY_SIZE(bits);
        } else {
            output_size = TF_PSA_CRYPTO_PQCP_MLDSA_SEED_SIZE;
        }
    }
#endif

    PSA_INIT();
    TEST_CALLOC(output1, output_size);
    TEST_CALLOC(output2, output_size);
    TEST_CALLOC(zero, output_size);

    psa_set_key_type(&attributes, type);
    psa_set_key_bits(&attributes, bits);

    /* Generate a key */
    PSA_ASSERT(psa_driver_wrapper_generate_key(&attributes,
                                               &custom, custom_data->x, custom_data->len,
                                               output1, output_size,
                                               &output_length1));
    TEST_LE_U(output_length1, output_size);
    TEST_LE_U(output_size - allow_shorter, output_length1);
    TEST_ASSERT(memcmp(output1, zero, output_length1));

    if (PSA_KEY_TYPE_IS_KEY_PAIR(type)) {
        psa_key_type_t public_type = PSA_KEY_TYPE_PUBLIC_KEY_OF_KEY_PAIR(type);
        size_t public_size = PSA_EXPORT_KEY_OUTPUT_SIZE(public_type, bits);
#if defined(TF_PSA_CRYPTO_PQCP_MLDSA_ENABLED)
        /* Hack alert: as above, the generic size macro doesn't know about
         * ML-DSA yet. */
        if (type == PSA_KEY_TYPE_ML_DSA_KEY_PAIR) {
            public_size = TF_PSA_CRYPTO_PQCP_MLDSA_PUBLIC_KEY_SIZE(bits);
        }
#endif
        size_t public_length = SIZE_MAX;
        TEST_CALLOC(public, public_size);
        PSA_ASSERT(psa_driver_wrapper_export_public_key(&attributes,
                                                        output1, output_length1,
                                                        public, public_size,
                                                        &public_length));

#if defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_GENERATE)
        if (type == PSA_KEY_TYPE_RSA_KEY_PAIR) {
            if (!check_rsa_public_exponent(custom_data->x, custom_data->len,
                                           public, public_length)) {
                goto exit;
            }
        }
#endif
    }

    /* Generate another key */
    PSA_ASSERT(psa_driver_wrapper_generate_key(&attributes,
                                               &custom, custom_data->x, custom_data->len,
                                               output2, output_size,
                                               &output_length2));
    TEST_LE_U(output_length2, output_size);
    TEST_LE_U(output_size - allow_shorter, output_length2);
    TEST_ASSERT(memcmp(output2, zero, output_length2));

    /* Check that successive calls produce different keys */
    if (output_length1 == output_length2) {
        TEST_ASSERT(memcmp(output1, output2, output_length1));
    }

exit:
    mbedtls_free(output1);
    mbedtls_free(output2);
    mbedtls_free(zero);
    mbedtls_free(public);
    psa_reset_key_attributes(&attributes);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE */
void export_public_key(int type_arg, int bits_arg,
                       data_t *key_buffer,
                       data_t *expected_public_key,
                       psa_status_t expected_status)
{
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
    uint8_t *public_key = NULL;

    PSA_INIT();

    psa_set_key_type(&attributes, type_arg);
    psa_set_key_bits(&attributes, bits_arg);

    /* Export into an exact-size buffer */
    /* Note that the API does not guarantee that an exact-size output buffer
     * works. The core could reject buffers that are smaller than
     * PSA_EXPORT_PUBLIC_KEY_OUTPUT_SIZE(type, bits), and then drivers
     * could have undefined behavior with such smaller buffers. If this happens,
     * this test will need to be adapted. */
    size_t public_key_size = expected_public_key->len;
    TEST_CALLOC(public_key, public_key_size);
    size_t public_key_length = SIZE_MAX;
    TEST_EQUAL(psa_driver_wrapper_export_public_key(&attributes,
                                                    key_buffer->x, key_buffer->len,
                                                    public_key, public_key_size,
                                                    &public_key_length),
               expected_status);
    if (expected_status == PSA_SUCCESS) {
        TEST_MEMORY_COMPARE(public_key, public_key_length,
                            expected_public_key->x, expected_public_key->len);
    }
    mbedtls_free(public_key);
    public_key = NULL;

    /* Export into a larger buffer */
    public_key_size = expected_public_key->len + 1;
    TEST_CALLOC(public_key, public_key_size);
    public_key_length = SIZE_MAX;
    TEST_EQUAL(psa_driver_wrapper_export_public_key(&attributes,
                                                    key_buffer->x, key_buffer->len,
                                                    public_key, public_key_size,
                                                    &public_key_length),
               expected_status);
    if (expected_status == PSA_SUCCESS) {
        TEST_MEMORY_COMPARE(public_key, public_key_length,
                            expected_public_key->x, expected_public_key->len);
    }
    mbedtls_free(public_key);
    public_key = NULL;

exit:
    mbedtls_free(public_key);
    psa_reset_key_attributes(&attributes);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE */
void sign_message_deterministic(int type_arg, int bits_arg, int alg_arg,
                                data_t *key_buffer,
                                data_t *message,
                                data_t *expected_signature,
                                psa_status_t expected_status)
{
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
    uint8_t *signature = NULL;

    PSA_INIT();

    psa_set_key_type(&attributes, type_arg);
    psa_set_key_bits(&attributes, bits_arg);

    /* Sign into an exact-size buffer */
    /* Note that the API does not guarantee that an exact-size output buffer
     * works. The core could reject buffers that are smaller than
     * PSA_SIGN_OUTPUT_SIZE(type, bits, alg), and then drivers
     * could have undefined behavior with such smaller buffers. If this happens,
     * this test will need to be adapted. */
    size_t signature_size = expected_signature->len;
    TEST_CALLOC(signature, signature_size);
    size_t signature_length = SIZE_MAX;
    TEST_EQUAL(psa_driver_wrapper_sign_message(&attributes,
                                               key_buffer->x, key_buffer->len,
                                               alg_arg,
                                               message->x, message->len,
                                               signature, signature_size,
                                               &signature_length),
               expected_status);
    if (expected_status == PSA_SUCCESS) {
        TEST_MEMORY_COMPARE(signature, signature_length,
                            expected_signature->x, expected_signature->len);
    }
    mbedtls_free(signature);
    signature = NULL;

    /* Sign into a larger buffer */
    signature_size = expected_signature->len + 1;
    TEST_CALLOC(signature, signature_size);
    signature_length = SIZE_MAX;
    TEST_EQUAL(psa_driver_wrapper_sign_message(&attributes,
                                               key_buffer->x, key_buffer->len,
                                               alg_arg,
                                               message->x, message->len,
                                               signature, signature_size,
                                               &signature_length),
               expected_status);
    if (expected_status == PSA_SUCCESS) {
        TEST_MEMORY_COMPARE(signature, signature_length,
                            expected_signature->x, expected_signature->len);
    }
    mbedtls_free(signature);
    signature = NULL;

exit:
    mbedtls_free(signature);
    psa_reset_key_attributes(&attributes);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE */
void verify_message(int type_arg, int bits_arg, int alg_arg,
                    data_t *public_key,
                    data_t *message,
                    data_t *signature,
                    psa_status_t expected_status)
{
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
    uint8_t *buf = NULL;

    PSA_INIT();

    psa_set_key_type(&attributes, type_arg);
    psa_set_key_bits(&attributes, bits_arg);

    TEST_EQUAL(psa_driver_wrapper_verify_message(&attributes,
                                                 public_key->x, public_key->len,
                                                 alg_arg,
                                                 message->x, message->len,
                                                 signature->x, signature->len),
               expected_status);

    if (expected_status == PSA_SUCCESS) {
        /* Try verifying a signature whose last byte is wrong */
        TEST_CALLOC(buf, signature->len);
        memcpy(buf, signature->x, signature->len);
        buf[signature->len - 1] ^= 1;
        TEST_EQUAL(psa_driver_wrapper_verify_message(
                       &attributes,
                       public_key->x, public_key->len,
                       alg_arg,
                       message->x, message->len,
                       buf, signature->len),
                   PSA_ERROR_INVALID_SIGNATURE);
        mbedtls_free(buf);
        buf  = NULL;

        /* Try verifying a signature that's too short */
        TEST_CALLOC(buf, signature->len - 1);
        memcpy(buf, signature->x, signature->len - 1);
        TEST_EQUAL(psa_driver_wrapper_verify_message(
                       &attributes,
                       public_key->x, public_key->len,
                       alg_arg,
                       message->x, message->len,
                       buf, signature->len - 1),
                   PSA_ERROR_INVALID_SIGNATURE);
        mbedtls_free(buf);
        buf  = NULL;

        /* Try verifying a signature that's too long */
        TEST_CALLOC(buf, signature->len + 1);
        memcpy(buf, signature->x, signature->len);
        TEST_EQUAL(psa_driver_wrapper_verify_message(
                       &attributes,
                       public_key->x, public_key->len,
                       alg_arg,
                       message->x, message->len,
                       buf, signature->len + 1),
                   PSA_ERROR_INVALID_SIGNATURE);
        mbedtls_free(buf);
        buf = NULL;
    }

exit:
    PSA_DONE();
    mbedtls_free(buf);
}
/* END_CASE */

/* BEGIN_CASE */
void sign_setup(int type_arg, int bits_arg, int alg_arg,
                data_t *key_buffer,
                psa_status_t expected_status)
{
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
    psa_sign_operation_t operation;
    memset(&operation, 0, sizeof(operation));

    PSA_INIT();

    psa_set_key_type(&attributes, type_arg);
    psa_set_key_bits(&attributes, bits_arg);

    TEST_EQUAL(psa_driver_wrapper_sign_setup(&operation,
                                             &attributes,
                                             key_buffer->x, key_buffer->len,
                                             alg_arg),
               expected_status);

    PSA_ASSERT(psa_driver_wrapper_sign_abort(&operation));

exit:
    psa_driver_wrapper_sign_abort(&operation);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE */
void sign_deterministic_multipart(
    int type, int bits, int alg, data_t *key_buffer,
    int n_chunks, data_t *chunk1, data_t *chunk2, data_t *chunk3,
    data_t *expected_signature, int expected_finish_status)
{
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
    psa_sign_operation_t operation;
    memset(&operation, 0, sizeof(operation));
    const size_t signature_size = expected_signature->len;
    size_t signature_length = SIZE_MAX;
    uint8_t *signature = NULL;

    PSA_INIT();
    TEST_CALLOC(signature, signature_size);

    psa_set_key_type(&attributes, type);
    psa_set_key_bits(&attributes, bits);

    PSA_ASSERT(psa_driver_wrapper_sign_setup(&operation,
                                             &attributes,
                                             key_buffer->x, key_buffer->len,
                                             alg));
    if (n_chunks >= 1) {
        PSA_ASSERT(psa_driver_wrapper_sign_update(&operation,
                                                  chunk1->x, chunk1->len));
    }
    if (n_chunks >= 2) {
        PSA_ASSERT(psa_driver_wrapper_sign_update(&operation,
                                                  chunk2->x, chunk2->len));
    }
    if (n_chunks >= 3) {
        PSA_ASSERT(psa_driver_wrapper_sign_update(&operation,
                                                  chunk3->x, chunk3->len));
    }
    TEST_EQUAL(psa_driver_wrapper_sign_finish(&operation,
                                              key_buffer->x, key_buffer->len,
                                              signature, signature_size,
                                              &signature_length),
               expected_finish_status);
    if (expected_finish_status == PSA_SUCCESS) {
        TEST_MEMORY_COMPARE(expected_signature->x, expected_signature->len,
                            signature, signature_length);
    }

exit:
    psa_driver_wrapper_sign_abort(&operation);
    PSA_DONE();
    mbedtls_free(signature);
}
/* END_CASE */

/* BEGIN_CASE */
void sign_deterministic_multipart_finish(
    int type, int bits, int alg, data_t *key_buffer,
    data_t *message,
    data_t *expected_signature, int signature_size_delta,
    int expected_finish_status)
{
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
    psa_sign_operation_t operation;
    memset(&operation, 0, sizeof(operation));
    const size_t signature_size = PSA_MLDSA_SIGNATURE_SIZE(bits) + signature_size_delta;
    size_t signature_length = SIZE_MAX;
    uint8_t *signature = NULL;

    PSA_INIT();
    TEST_CALLOC(signature, signature_size);

    psa_set_key_type(&attributes, type);
    psa_set_key_bits(&attributes, bits);

    PSA_ASSERT(psa_driver_wrapper_sign_setup(&operation,
                                             &attributes,
                                             key_buffer->x, key_buffer->len,
                                             alg));
    PSA_ASSERT(psa_driver_wrapper_sign_update(&operation,
                                              message->x, message->len));
    TEST_EQUAL(psa_driver_wrapper_sign_finish(&operation,
                                              key_buffer->x, key_buffer->len,
                                              signature, signature_size,
                                              &signature_length),
               expected_finish_status);
    if (expected_finish_status == PSA_SUCCESS) {
        TEST_MEMORY_COMPARE(expected_signature->x, expected_signature->len,
                            signature, signature_length);
    }

exit:
    psa_driver_wrapper_sign_abort(&operation);
    PSA_DONE();
    mbedtls_free(signature);
}
/* END_CASE */

/* BEGIN_CASE */
void verify_setup(int type_arg, int bits_arg, int alg_arg,
                  data_t *public_key,
                  psa_status_t expected_status)
{
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
    psa_verify_operation_t operation;
    memset(&operation, 0, sizeof(operation));

    PSA_INIT();

    psa_set_key_type(&attributes, type_arg);
    psa_set_key_bits(&attributes, bits_arg);

    TEST_EQUAL(psa_driver_wrapper_verify_setup(&operation,
                                               &attributes,
                                               public_key->x, public_key->len,
                                               alg_arg),
               expected_status);

    PSA_ASSERT(psa_driver_wrapper_verify_abort(&operation));

exit:
    psa_driver_wrapper_verify_abort(&operation);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE */
void verify_multipart(
    int type, int bits, int alg, data_t *public_key,
    int n_chunks, data_t *chunk1, data_t *chunk2, data_t *chunk3,
    data_t *signature, int expected_verify_status)
{
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
    psa_verify_operation_t operation;
    memset(&operation, 0, sizeof(operation));

    PSA_INIT();

    psa_set_key_type(&attributes, type);
    psa_set_key_bits(&attributes, bits);

    PSA_ASSERT(psa_driver_wrapper_verify_setup(&operation,
                                               &attributes,
                                               public_key->x, public_key->len,
                                               alg));
    if (n_chunks >= 1) {
        PSA_ASSERT(psa_driver_wrapper_verify_update(&operation,
                                                    chunk1->x, chunk1->len));
    }
    if (n_chunks >= 2) {
        PSA_ASSERT(psa_driver_wrapper_verify_update(&operation,
                                                    chunk2->x, chunk2->len));
    }
    if (n_chunks >= 3) {
        PSA_ASSERT(psa_driver_wrapper_verify_update(&operation,
                                                    chunk3->x, chunk3->len));
    }
    TEST_EQUAL(psa_driver_wrapper_verify_finish(&operation,
                                                public_key->x, public_key->len,
                                                signature->x, signature->len),
               expected_verify_status);

exit:
    psa_driver_wrapper_verify_abort(&operation);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE */
void verify_multipart_finish(
    int type, int bits, int alg,
    data_t *setup_public_key, data_t *finish_public_key,
    data_t *message,
    data_t *signature, int expected_verify_status)
{
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
    psa_verify_operation_t operation;
    memset(&operation, 0, sizeof(operation));
    /* Temporary copy of the public key which is freed as soon as the
     * library function returns. This lets us validate that the
     * library doesn't rely on the key pointer remaining valid
     * throughout the operation. */
    uint8_t *public_key = NULL;

    PSA_INIT();

    psa_set_key_type(&attributes, type);
    psa_set_key_bits(&attributes, bits);

    TEST_CALLOC(public_key, setup_public_key->len);
    memcpy(public_key, setup_public_key->x, setup_public_key->len);
    PSA_ASSERT(psa_driver_wrapper_verify_setup(&operation,
                                               &attributes,
                                               public_key, setup_public_key->len,
                                               alg));
    mbedtls_free(public_key);
    public_key = NULL;

    PSA_ASSERT(psa_driver_wrapper_verify_update(&operation, message->x, message->len));

    TEST_CALLOC(public_key, finish_public_key->len);
    if (finish_public_key->len != 0) {
        memcpy(public_key, finish_public_key->x, finish_public_key->len);
    }
    TEST_EQUAL(psa_driver_wrapper_verify_finish(&operation,
                                                public_key, finish_public_key->len,
                                                signature->x, signature->len),
               expected_verify_status);
    mbedtls_free(public_key);
    public_key = NULL;

exit:
    psa_driver_wrapper_verify_abort(&operation);
    PSA_DONE();
    mbedtls_free(public_key);
}
/* END_CASE */
