/* BEGIN_HEADER */
#include "ascon_internal.h"

#if defined(MBEDTLS_TEST_HOOKS)
static int permutation_state_from_bytes(
    const data_t *bytes,
    tf_psa_crypto_ascon_p_state_t *state)
{
    if (bytes->len != 40) {
        return 0;
    }
    state->S[0] = MBEDTLS_GET_UINT64_LE(bytes->x, 0);
    state->S[1] = MBEDTLS_GET_UINT64_LE(bytes->x, 8);
    state->S[2] = MBEDTLS_GET_UINT64_LE(bytes->x, 16);
    state->S[3] = MBEDTLS_GET_UINT64_LE(bytes->x, 24);
    state->S[4] = MBEDTLS_GET_UINT64_LE(bytes->x, 32);
    return 1;
}

static int permutation_state_equals(
    const tf_psa_crypto_ascon_p_state_t *actual_state,
    const tf_psa_crypto_ascon_p_state_t *expected_state)
{
    TEST_EQUAL(actual_state->S[0], expected_state->S[0]);
    TEST_EQUAL(actual_state->S[1], expected_state->S[1]);
    TEST_EQUAL(actual_state->S[2], expected_state->S[2]);
    TEST_EQUAL(actual_state->S[3], expected_state->S[3]);
    TEST_EQUAL(actual_state->S[4], expected_state->S[4]);
    return 1;

exit:
    return 0;
}
#endif /* MBEDTLS_TEST_HOOKS */

/* END_HEADER */

/* BEGIN_DEPENDENCIES
 * depends_on:MBEDTLS_PSA_BUILTIN_SOME_ASCON
 * END_DEPENDENCIES
 */

/* BEGIN_CASE depends_on:MBEDTLS_TEST_HOOKS */
void permute_round(int rounds, int i,
                   const data_t *input_bytes,
                   const data_t *expected_output_bytes)
{
    tf_psa_crypto_ascon_p_state_t state;
    tf_psa_crypto_ascon_p_state_t expected_output_state;

    TEST_ASSERT(permutation_state_from_bytes(input_bytes, &state));
    TEST_ASSERT(permutation_state_from_bytes(expected_output_bytes,
                                             &expected_output_state));

    tf_psa_crypto_ascon_permute_round(&state, rounds, i);

    if (!permutation_state_equals(&state, &expected_output_state)) {
        goto exit;
    }
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_TEST_HOOKS */
void permute(int rounds,
             const data_t *input_bytes,
             const data_t *expected_output_bytes)
{
    tf_psa_crypto_ascon_p_state_t state;
    tf_psa_crypto_ascon_p_state_t expected_output_state;

    TEST_ASSERT(permutation_state_from_bytes(input_bytes, &state));
    TEST_ASSERT(permutation_state_from_bytes(expected_output_bytes,
                                             &expected_output_state));

    tf_psa_crypto_ascon_permute(&state, rounds);

    if (!permutation_state_equals(&state, &expected_output_state)) {
        goto exit;
    }
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_PSA_BUILTIN_ALG_ASCON_HASH256 */
void hash256_single(const data_t *message,
                    const data_t *expected_output)
{
    tf_psa_crypto_ascon_8_state_t state;
    uint8_t actual_output[32];

    tf_psa_crypto_ascon_hash256_setup(&state);
    tf_psa_crypto_ascon_hash256_update(&state, message->x, message->len);
    tf_psa_crypto_ascon_hash256_finish(&state, actual_output);
    TEST_MEMORY_COMPARE(actual_output, sizeof(actual_output),
                        expected_output->x, expected_output->len);
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_PSA_BUILTIN_ALG_ASCON_HASH256 */
void hash256_two_parts(const data_t *message,
                       const data_t *expected_output)
{
    tf_psa_crypto_ascon_8_state_t state;
    uint8_t actual_output[32];

    for (size_t n = 0; n <= message->len; n++) {
        mbedtls_test_set_step(n);
        tf_psa_crypto_ascon_hash256_setup(&state);
        tf_psa_crypto_ascon_hash256_update(&state, message->x, n);
        tf_psa_crypto_ascon_hash256_update(&state, message->x + n, message->len - n);
        tf_psa_crypto_ascon_hash256_finish(&state, actual_output);
        TEST_MEMORY_COMPARE(actual_output, sizeof(actual_output),
                            expected_output->x, expected_output->len);
    }
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_PSA_BUILTIN_ALG_ASCON_HASH256 */
void hash256_multi(int chunks,
                   const data_t *chunk1,
                   const data_t *chunk2,
                   const data_t *chunk3,
                   const data_t *chunk4,
                   const data_t *expected_output)
{
    tf_psa_crypto_ascon_8_state_t state;

    tf_psa_crypto_ascon_hash256_setup(&state);

    if (chunks <= 0) {
        goto input_done;
    }
    tf_psa_crypto_ascon_hash256_update(&state, chunk1->x, chunk1->len);
    if (chunks <= 1) {
        goto input_done;
    }
    tf_psa_crypto_ascon_hash256_update(&state, chunk2->x, chunk2->len);
    if (chunks <= 2) {
        goto input_done;
    }
    tf_psa_crypto_ascon_hash256_update(&state, chunk3->x, chunk3->len);
    if (chunks <= 3) {
        goto input_done;
    }
    tf_psa_crypto_ascon_hash256_update(&state, chunk4->x, chunk4->len);
    if (chunks <= 4) {
        goto input_done;
    }
    TEST_FAIL("Not enough chunks available");

input_done: ;
    uint8_t actual_output[32];
    tf_psa_crypto_ascon_hash256_finish(&state, actual_output);
    TEST_MEMORY_COMPARE(actual_output, sizeof(actual_output),
                        expected_output->x, expected_output->len);
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_PSA_BUILTIN_ALG_ASCON_XOF128 */
void xof128_single(const data_t *message,
                   const data_t *expected_output)
{
    tf_psa_crypto_ascon_8_state_t state;
    uint8_t *output1 = NULL;

    for (size_t n1 = 0; n1 <= expected_output->len; n1++) {
        TEST_CALLOC(output1, n1);
        mbedtls_test_set_step(n1);
        tf_psa_crypto_ascon_xof128_setup(&state);
        tf_psa_crypto_ascon_xof128_update(&state, message->x, message->len);
        tf_psa_crypto_ascon_xof128_finish(&state);
        tf_psa_crypto_ascon_xof128_output(&state, output1, n1);
        TEST_MEMORY_COMPARE(output1, n1, expected_output->x, n1);
        mbedtls_free(output1);
        output1 = NULL;
    }

exit:
    mbedtls_free(output1);
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_PSA_BUILTIN_ALG_ASCON_XOF128 */
void xof128_multi_out(const data_t *message,
                      const data_t *expected_output)
{
    tf_psa_crypto_ascon_8_state_t state;
    uint8_t *output1 = NULL;
    uint8_t *output2 = NULL;
    uint8_t *output3 = NULL;

    for (size_t n1 = 0; n1 <= expected_output->len; n1++) {
        for (size_t n2 = 0; n2 <= expected_output->len - n1; n2++) {
            size_t n3 = expected_output->len - n1 - n2;
            TEST_CALLOC(output1, n1);
            TEST_CALLOC(output2, n2);
            TEST_CALLOC(output3, n3);
            mbedtls_test_set_step(n1 * 1000000 + n2 * 1000 + n3);
            tf_psa_crypto_ascon_xof128_setup(&state);
            tf_psa_crypto_ascon_xof128_update(&state, message->x, message->len);
            tf_psa_crypto_ascon_xof128_finish(&state);
            tf_psa_crypto_ascon_xof128_output(&state, output1, n1);
            tf_psa_crypto_ascon_xof128_output(&state, output2, n2);
            tf_psa_crypto_ascon_xof128_output(&state, output3, n3);
            TEST_MEMORY_COMPARE(output1, n1, expected_output->x, n1);
            TEST_MEMORY_COMPARE(output2, n2, expected_output->x + n1, n2);
            TEST_MEMORY_COMPARE(output3, n3, expected_output->x + n1 + n2, n3);
            mbedtls_free(output1);
            output1 = NULL;
            mbedtls_free(output2);
            output2 = NULL;
            mbedtls_free(output3);
            output3 = NULL;
        }
    }

exit:
    mbedtls_free(output1);
    mbedtls_free(output2);
    mbedtls_free(output3);
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_PSA_BUILTIN_ALG_ASCON_CXOF128 */
void cxof128_single(const data_t *context,
                    const data_t *message,
                    const data_t *expected_output)
{
    tf_psa_crypto_ascon_8_state_t state;
    uint8_t *output = NULL;

    TEST_CALLOC(output, expected_output->len);
    tf_psa_crypto_ascon_cxof128_setup(&state, context->x, context->len);
    tf_psa_crypto_ascon_xof128_update(&state, message->x, message->len);
    tf_psa_crypto_ascon_xof128_finish(&state);
    tf_psa_crypto_ascon_xof128_output(&state, output, expected_output->len);
    TEST_MEMORY_COMPARE(output, expected_output->len,
                        expected_output->x, expected_output->len);

exit:
    mbedtls_free(output);
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_PSA_BUILTIN_ALG_ASCON_AEAD128 */
void aead128_simple(const data_t *key,
                    const data_t *nonce,
                    const data_t *ad,
                    const data_t *plaintext,
                    const data_t *ciphertext,
                    const data_t *expected_tag)
{
    tf_psa_crypto_ascon_16_state_t state;
    uint8_t *output = NULL;
    uint8_t actual_tag[16];
    memset(actual_tag, 'i', sizeof(actual_tag));

    /* The plaintext and ciphertext must be the same length in valid data.
     * Memory management in the test code depends on it. */
    TEST_EQUAL(plaintext->len, ciphertext->len);

    TEST_CALLOC(output, ciphertext->len);

    tf_psa_crypto_ascon_aead128_setup(&state, key->x, nonce->x);
    tf_psa_crypto_ascon_aead128_update_ad(&state, ad->x, ad->len);
    tf_psa_crypto_ascon_aead128_finish_ad(&state);
    tf_psa_crypto_ascon_aead128_update(&state, 0,
                                       plaintext->x, output, plaintext->len);
    tf_psa_crypto_ascon_aead128_finish(&state, 0, key->x, actual_tag);
    TEST_MEMORY_COMPARE(output, ciphertext->len,
                        ciphertext->x, ciphertext->len);
    TEST_MEMORY_COMPARE(actual_tag, sizeof(actual_tag),
                        expected_tag->x, expected_tag->len);

    tf_psa_crypto_ascon_aead128_setup(&state, key->x, nonce->x);
    tf_psa_crypto_ascon_aead128_update_ad(&state, ad->x, ad->len);
    tf_psa_crypto_ascon_aead128_finish_ad(&state);
    tf_psa_crypto_ascon_aead128_update(&state, 1,
                                       ciphertext->x, output, ciphertext->len);
    tf_psa_crypto_ascon_aead128_finish(&state, 1, key->x, actual_tag);
    TEST_MEMORY_COMPARE(output, plaintext->len,
                        plaintext->x, plaintext->len);
    TEST_MEMORY_COMPARE(actual_tag, sizeof(actual_tag),
                        expected_tag->x, expected_tag->len);

exit:
    mbedtls_free(output);
}
/* END_CASE */
